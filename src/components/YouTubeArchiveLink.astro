---
import { youtubeChannelUrl } from '../data/videoArchive';
---

<a class="youtube-archive-link" href={youtubeChannelUrl} target="_blank" rel="noopener noreferrer">
	<span class="youtube-mark" aria-hidden="true">▶</span>
	<span class="youtube-copy"><strong>全ての作品はYouTubeから！</strong><span>MVも、アニメも、短編も。チャンネルで公開中。</span></span>
	<span class="youtube-arrow" aria-hidden="true">↗</span>
</a>

<style>
	.youtube-archive-link { display: flex; align-items: center; gap: clamp(16px, 3vw, 42px); padding: clamp(24px, 4vw, 52px); border: 2px solid var(--studio-ink); background: var(--studio-accent); color: var(--studio-ink); text-decoration: none; }
	.youtube-mark { display: grid; flex: 0 0 auto; place-items: center; width: 56px; height: 40px; border-radius: 11px; background: var(--studio-ink); color: var(--studio-accent); font-size: 20px; }
	.youtube-copy { display: grid; gap: 12px; min-width: 0; }
	.youtube-copy strong { font-family: var(--font-brand); font-size: clamp(1.3rem, 2.5vw, 2.7rem); font-weight: var(--font-brand-weight); line-height: 1.5; overflow-wrap: anywhere; }
	.youtube-copy > span { font-size: 14px; line-height: 1.7; }
	.youtube-arrow { margin-left: auto; font-size: clamp(32px, 5vw, 64px); }
	.youtube-archive-link:hover .youtube-copy strong { text-decoration: underline; text-underline-offset: 6px; }
	@media (max-width: 620px) { .youtube-mark { display: none; } .youtube-copy > span { font-size: 12px; } }
</style>
