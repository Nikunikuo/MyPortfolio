---
import type { ArchiveVideo } from '../data/videoArchive';
import { youtubeWatchUrl } from '../data/videoArchive';

interface Props {
	video: ArchiveVideo;
	index: number;
}

const { video, index } = Astro.props;
---

<article class="video-card" data-video-id={video.id}>
	<a class="video-card-link" href={youtubeWatchUrl(video.id)} target="_blank" rel="noopener noreferrer" aria-label={`${video.title}をYouTubeで見る（新しいタブ）`}>
		<div class="video-card-image">
			<img src={`https://i.ytimg.com/vi/${video.id}/${video.thumbnail ?? 'hqdefault'}.jpg`} alt="" width="1280" height="720" loading="lazy" decoding="async" />
			<span class="video-card-play" aria-hidden="true">▶</span>
			<span class="video-card-watch">YouTubeで見る <span aria-hidden="true">↗</span></span>
		</div>
		<div class="video-card-meta"><span>{video.label}</span><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></div>
		<h2>{video.title}</h2>
		<p>{video.description}</p>
	</a>
	{video.detailHref && <a class="video-card-detail" href={video.detailHref}>作品の記録を読む <span aria-hidden="true">→</span></a>}
</article>

<style>
	.video-card { min-width: 0; }
	.video-card-link { display: block; color: inherit; text-decoration: none; }
	.video-card-image { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border: 2px solid var(--studio-ink); background: var(--studio-ink); box-shadow: 5px 5px 0 var(--studio-ink); }
	.video-card-image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 220ms ease; }
	.video-card-play { position: absolute; inset: 0; display: grid; place-items: center; width: 54px; height: 54px; margin: auto; padding-left: 3px; border: 2px solid white; border-radius: 50%; background: #171b16c9; color: white; font-size: 19px; transition: background-color 160ms ease; }
	.video-card-watch { position: absolute; right: 0; bottom: 0; display: flex; align-items: center; gap: 14px; padding: 7px 12px; background: var(--studio-accent); color: var(--studio-ink); font-size: 12px; font-weight: 700; }
	.video-card-meta { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 22px; color: var(--studio-muted); font-size: 12px; font-weight: 700; }
	.video-card-meta > span:last-child { font-family: "IBM Plex Mono", monospace; }
	.video-card h2 { margin: 10px 0; font-family: var(--font-body); font-size: clamp(1.3rem, 2vw, 2rem); font-weight: 800; letter-spacing: .01em; line-height: 1.55; overflow-wrap: anywhere; }
	.video-card p { margin: 0; color: var(--studio-muted); font-size: 14px; line-height: 1.85; }
	.video-card-detail { display: inline-flex; gap: 12px; margin-top: 16px; padding-block: 6px; border-bottom: 1px solid; color: inherit; font-size: 13px; font-weight: 700; text-decoration: none; }
	.video-card-link:hover img, .video-card-link:focus-visible img { transform: scale(1.035); }
	.video-card-link:hover .video-card-play, .video-card-link:focus-visible .video-card-play { background: #d93025; }
	.video-card-link:hover h2 { text-decoration: underline; text-underline-offset: 5px; }
	@media (prefers-reduced-motion: reduce) { .video-card-image img, .video-card-play { transition: none; } }
</style>
