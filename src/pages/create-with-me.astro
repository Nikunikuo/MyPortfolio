---
import CreatorLayout from '../layouts/CreatorLayout.astro';

const mailAddress = 'yajusika@gmail.com';
const title = '仕事の相談 | 大鹿ニク';
const description = 'MV、AIアニメーション、プロモーション映像、Webなどの制作相談・見積り窓口。内容が固まっていない段階でもご相談いただけます。';

const creativeImages = [
	{
		src: '/images/creat1.png',
		width: 1672,
		height: 941,
		alt: '言葉から映像へ、思いをかたちにする制作サービスの紹介ビジュアル',
	},
	{
		src: '/images/creat2.png',
		width: 1672,
		height: 941,
		alt: 'ヒアリングから納品までの制作の流れを説明するビジュアル',
	},
	{
		src: '/images/creat3.png',
		width: 1402,
		height: 1122,
		alt: '想いを映像として届く形にすることを表現したキービジュアル',
	},
];

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	name: '仕事の相談',
	description,
	url: 'https://niku.studio/create-with-me/',
	inLanguage: 'ja-JP',
};
---

<CreatorLayout
	title={title}
	description={description}
	eyebrow="CREATE WITH ME"
	heading="仕事の相談"
	intro="まだ説明しきれないイメージでも大丈夫です。つくりたいものと、その理由から聞かせてください。"
	number="04"
	structuredData={structuredData}
>
	<section class="creator-section showcase-section" aria-labelledby="showcase-title">
		<header class="creator-section-heading">
			<p class="creator-section-kicker">WHAT I MAKE</p>
			<h2 id="showcase-title">言葉から映像へ</h2>
		</header>
		<div class="creator-section-content showcase-grid">
			{
				creativeImages.map((image, index) => (
					<figure class="creator-media-frame showcase-item">
						<span>{String(index + 1).padStart(2, '0')}</span>
						<img
							src={image.src}
							alt={image.alt}
							width={image.width}
							height={image.height}
							loading={index === 0 ? 'eager' : 'lazy'}
							decoding="async"
						/>
					</figure>
				))
			}
		</div>
	</section>

	<section class="request-block" id="contact" aria-labelledby="request-title">
		<div class="request-copy">
			<p class="creator-section-kicker">CONTACT</p>
			<h2 id="request-title">話を<span class="request-heading-line">聞かせてください。</span></h2>
			<p>ご希望の雰囲気、参考作品、目的、希望納期など、分かる範囲で構いません。入力内容を入れたメール作成画面が開きます。</p>
			<dl>
				<div><dt>相談できること</dt><dd>MV / AIアニメーション / PR映像 / Web / 企画相談</dd></div>
				<div><dt>直接メール</dt><dd><a href={`mailto:${mailAddress}`}>{mailAddress}</a></dd></div>
			</dl>
		</div>

		<form id="work-request-form" class="request-form">
			<div class="field">
				<label for="name">お名前 / 会社名 <span>必須</span></label>
				<input id="name" name="name" type="text" autocomplete="name" placeholder="株式会社〇〇 / 山田太郎" required />
			</div>

			<div class="field">
				<label for="email">メールアドレス <span>必須</span></label>
				<input id="email" name="email" type="email" autocomplete="email" placeholder="example@example.com" required />
			</div>

			<div class="field">
				<label for="projectType">ご相談内容の種類</label>
				<input id="projectType" name="projectType" type="text" placeholder="MV制作 / AIアニメーション / PR映像 / 企画相談" />
			</div>

			<div class="field">
				<label for="message">ご相談内容 <span>必須</span></label>
				<textarea
					id="message"
					name="message"
					placeholder="制作したい内容、目的、参考URL、希望納期、ご予算感など。ざっくりでも問題ありません。"
					required></textarea>
			</div>

			<div class="submit-row">
				<p>送信前にメール本文を確認できます。</p>
				<button type="submit">メールを作成する <span aria-hidden="true">↗</span></button>
			</div>
		</form>
	</section>

	<script define:vars={{ mailAddress }} data-astro-rerun>
		(() => {
		const form = document.getElementById('work-request-form');
		if (!form || form.dataset.initialized === 'true') return;
		form.dataset.initialized = 'true';

		form?.addEventListener('submit', (event) => {
			event.preventDefault();

			const data = new FormData(form);
			const name = String(data.get('name') || '').trim();
			const email = String(data.get('email') || '').trim();
			const projectType = String(data.get('projectType') || '').trim();
			const message = String(data.get('message') || '').trim();

			const subject = encodeURIComponent(`【制作相談】${name || 'お仕事依頼'}`);
			const body = encodeURIComponent(
				[
					'大鹿ニク 宛',
					'',
					'ポートフォリオサイトから制作相談を送ります。',
					'',
					`お名前 / 会社名: ${name}`,
					`メールアドレス: ${email}`,
					`ご相談内容の種類: ${projectType || '未入力'}`,
					'',
					'ご相談内容:',
					message,
				].join('\n')
			);

			window.location.href = `mailto:${mailAddress}?subject=${subject}&body=${body}`;
		});
		})();
	</script>
</CreatorLayout>

<style>
	.showcase-section {
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(28px, 4vw, 60px);
	}

	.showcase-section > .creator-section-heading {
		position: static;
	}

	.showcase-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(32px, 5vw, 76px);
	}

	.showcase-item {
		min-width: 0;
	}

	.showcase-item img {
		height: auto;
		object-fit: contain;
	}

	.showcase-item > span {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 2;
		padding: 11px 14px;
		background: var(--studio-accent);
		color: var(--studio-ink);
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.82rem;
		font-weight: 600;
	}

	.request-block {
		display: grid;
		grid-template-columns: minmax(250px, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(40px, 8vw, 130px);
		margin-bottom: clamp(50px, 8vw, 100px);
		padding: clamp(42px, 7vw, 96px);
		border-top: 2px solid var(--studio-ink);
		background: var(--studio-paper);
		color: var(--studio-ink);
		border: 2px solid var(--studio-ink);
		box-shadow: 10px 10px 0 var(--studio-ink);
	}

	.request-copy h2 {
		margin: 0;
		color: inherit;
		font-family: var(--font-brand);
		font-size: clamp(1.75rem, 3vw, 3rem);
		font-weight: 900;
		letter-spacing: -0.07em;
		line-height: 1.2;
	}

	.request-copy > p:not(.creator-section-kicker) {
		margin: 34px 0 0;
		line-height: 1.9;
	}

	.request-heading-line { display: block; }

	.request-copy dl {
		margin-top: 54px;
	}

	.request-copy dl > div {
		padding: 16px 0;
		border-top: 1px solid rgba(9, 9, 8, 0.34);
	}

	.request-copy dt {
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
	}

	.request-copy dd {
		margin: 7px 0 0;
		font-weight: 700;
		line-height: 1.6;
	}

	.request-copy a {
		color: inherit;
		text-decoration-color: var(--studio-ink);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.2em;
	}

	.request-form {
		display: grid;
		align-content: start;
		gap: 28px;
	}

	.field {
		display: grid;
		gap: 10px;
	}

	.field label {
		font-size: 0.92rem;
		font-weight: 900;
	}

	.field label span {
		margin-left: 8px;
		color: #ad291a;
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.75rem;
	}

	.field input,
	.field textarea {
		width: 100%;
		padding: 16px 2px;
		border: 0;
		border-bottom: 2px solid var(--studio-ink);
		border-radius: 0;
		background: transparent;
		color: var(--studio-ink);
		font: inherit;
		outline: none;
	}

	.field input::placeholder,
	.field textarea::placeholder {
		color: var(--studio-muted);
	}

	.field input:focus,
	.field textarea:focus {
		border-color: var(--studio-ink);
		box-shadow: 0 3px 0 var(--studio-accent);
	}

	.field textarea {
		min-height: 180px;
		resize: vertical;
		line-height: 1.8;
	}

	.submit-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		margin-top: 12px;
	}

	.submit-row p {
		color: #68665f;
		font-size: 0.82rem;
	}

	.submit-row button {
		flex: 0 0 auto;
		padding: 17px 20px;
		border: 2px solid var(--studio-ink);
		border-radius: 0;
		background: var(--studio-accent);
		color: var(--studio-ink);
		font: inherit;
		font-weight: 900;
		cursor: pointer;
	}

	.submit-row button:hover,
	.submit-row button:focus-visible {
		background: var(--studio-ink);
		color: var(--studio-accent);
		outline: none;
	}

	@media (max-width: 900px) {
		.request-block {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 760px) {
		.showcase-grid {
			margin-inline: calc(12px - var(--studio-gutter));
		}
	}

	@media (max-width: 620px) {
		.request-block {
			padding: 52px 22px;
		}

		.submit-row {
			align-items: stretch;
			flex-direction: column;
		}

		.submit-row button {
			width: 100%;
		}
	}
</style>
