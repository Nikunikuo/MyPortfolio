---
import CreatorLayout from '../../layouts/CreatorLayout.astro';
import { challenges100days, categoryLabels } from '../../data/100daysData';

const title = '#AI創作100日チャレンジ | 大鹿ニク';
const description = '2025年8月9日から100日間、生成AIを使って毎日続けた創作の記録。音楽、アニメ、漫画、ツール、実験を日ごとに辿れます。';
const firstDay = challenges100days[0];
const lastDay = challenges100days[challenges100days.length - 1];

const categories = [
	{ key: 'all', label: 'すべて' },
	{ key: 'music', label: '音楽' },
	{ key: 'anime', label: 'アニメ' },
	{ key: 'tool', label: 'ツール' },
	{ key: 'manga', label: '漫画' },
	{ key: 'other', label: 'その他' },
];

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: '#AI創作100日チャレンジ',
	description,
	url: 'https://niku.studio/100days/',
	inLanguage: 'ja-JP',
	mainEntity: {
		'@type': 'ItemList',
		numberOfItems: challenges100days.length,
		itemListElement: challenges100days.map((challenge) => ({
			'@type': 'ListItem',
			position: challenge.day,
			name: challenge.title,
			description: challenge.summary,
		})),
	},
};
---

<CreatorLayout
	title={title}
	description={description}
	eyebrow="100 DAYS / CREATIVE LOG"
	heading="#AI創作100日"
	intro="毎日ひとつ、何かをつくる。うまくいった日も、失敗した日も、そのまま100日分残しています。"
	number="100"
	backHref="/work/"
	backLabel="その他制作物の倉庫"
	structuredData={structuredData}
>
	<section class="challenge-overview" aria-label="チャレンジ概要">
		<div>
			<strong>{challenges100days.length}</strong>
			<span>DAYS / COMPLETE</span>
		</div>
		<dl>
			<div><dt>START</dt><dd>{firstDay?.date.replaceAll('-', '.')}</dd></div>
			<div><dt>FINISH</dt><dd>{lastDay?.date.replaceAll('-', '.')}</dd></div>
			<div><dt>RANGE</dt><dd>MUSIC / ANIME / TOOL / MANGA / OTHER</dd></div>
		</dl>
	</section>

	<section class="archive-controls" aria-label="制作記録の絞り込み">
		<div class="search-field">
			<label for="searchInput">キーワード検索</label>
			<input id="searchInput" type="search" placeholder="タイトルや内容を検索" autocomplete="off" />
		</div>
		<div class="filter-group" aria-label="カテゴリ">
			<span>FILTER</span>
			{
				categories.map((category, index) => (
					<button class:list={['filter-btn', { active: index === 0 }]} type="button" data-category={category.key} aria-pressed={index === 0}>
						{category.label}
					</button>
				))
			}
		</div>
		<div class="sort-group" aria-label="並び順">
			<span>SORT</span>
			<button class="sort-btn active" type="button" data-sort="asc" aria-pressed="true">01 → 100</button>
			<button class="sort-btn" type="button" data-sort="desc" aria-pressed="false">100 → 01</button>
		</div>
	</section>

	<section class="challenge-grid" id="cardsGrid" aria-label="100日分の制作記録">
		{
			challenges100days.map((challenge) => (
				<button
					type="button"
					class="challenge-card"
					data-day={challenge.day}
					data-date={challenge.date}
					data-category={challenge.category}
					data-title={challenge.title.toLowerCase()}
					data-summary={challenge.summary.toLowerCase()}
					data-modal-title={challenge.title}
					data-modal-summary={challenge.summary}
					data-grok-comment={challenge.grokComment}
					data-grok-emotion={challenge.grokEmotion}
					aria-label={`${challenge.day}日目、${challenge.title}の詳細を開く`}
				>
					<span class="challenge-image">
						<img src={challenge.imagePath} alt="" width="640" height="360" loading="lazy" decoding="async" />
						<b>{String(challenge.day).padStart(3, '0')}</b>
					</span>
					<span class="challenge-copy">
						<small>{challenge.date.replaceAll('-', '.')} / {categoryLabels[challenge.category]}</small>
						<strong>{challenge.title}</strong>
						<i aria-hidden="true">↗</i>
					</span>
				</button>
			))
		}
	</section>

	<div id="noResults" class="no-results" hidden aria-live="polite">
		<strong>NO RESULT</strong>
		<p>該当する記録が見つかりませんでした。</p>
	</div>

	<div id="modal" class="challenge-modal" hidden role="dialog" aria-modal="true" aria-labelledby="modal-title">
		<div class="modal-panel">
			<button class="modal-close" id="modalClose" type="button" aria-label="詳細を閉じる">CLOSE ×</button>
			<div id="modalBody"></div>
		</div>
	</div>
</CreatorLayout>

<style is:global>
	.challenge-overview {
		display: grid;
		grid-template-columns: minmax(210px, 0.42fr) minmax(0, 1fr);
		gap: clamp(28px, 6vw, 96px);
		padding-bottom: clamp(70px, 10vw, 130px);
		border-bottom: 2px solid var(--studio-ink);
	}

	.challenge-overview > div {
		display: flex;
		flex-direction: column;
	}

	.challenge-overview strong {
		color: var(--studio-ink);
		font-family: var(--font-brand);
		font-size: clamp(4rem, 9vw, 8.5rem);
		font-weight: var(--font-brand-weight);
		letter-spacing: var(--tracking-heading);
		line-height: 1;
	}

	.challenge-overview span,
	.challenge-overview dt,
	.challenge-overview dd {
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.82rem;
	}

	.challenge-overview span {
		margin-top: 22px;
		letter-spacing: 0.12em;
	}

	.challenge-overview dl {
		align-self: end;
		margin: 0;
	}

	.challenge-overview dl > div {
		display: grid;
		grid-template-columns: 90px minmax(0, 1fr);
		gap: 20px;
		padding: 17px 0;
		border-top: 1px solid var(--studio-line);
	}

	.challenge-overview dt {
		color: var(--studio-ink);
	}

	.challenge-overview dd {
		margin: 0;
		color: var(--studio-ink);
		line-height: 1.7;
	}

	.archive-controls {
		position: sticky;
		top: 0;
		z-index: 20;
		display: grid;
		grid-template-columns: minmax(250px, 1fr) minmax(0, 1.5fr) auto;
		gap: 24px;
		align-items: end;
		margin: 0 0 clamp(48px, 7vw, 90px);
		padding: 24px 0;
		border-bottom: 2px solid var(--studio-ink);
		background: var(--studio-panel);
		backdrop-filter: blur(14px);
	}

	.search-field {
		display: grid;
		gap: 8px;
	}

	.search-field label,
	.filter-group > span,
	.sort-group > span {
		color: var(--studio-ink);
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
	}

	.search-field input {
		width: 100%;
		padding: 10px 0;
		border: 0;
		border-bottom: 1px solid var(--studio-ink);
		border-radius: 0;
		background: transparent;
		color: var(--studio-ink);
		font: inherit;
		outline: none;
	}

	.search-field input:focus {
		border-color: var(--studio-ink);
	}
	.search-field input::placeholder { color: var(--studio-muted); }

	.filter-group,
	.sort-group {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		align-items: center;
	}

	.filter-group > span,
	.sort-group > span {
		margin-right: 5px;
	}

	.filter-btn,
	.sort-btn {
		padding: 8px 10px;
		border: 1px solid var(--studio-line);
		border-radius: 0;
		background: transparent;
		color: var(--studio-ink);
		font: inherit;
		font-size: 0.82rem;
		font-weight: 700;
		cursor: pointer;
	}

	.filter-btn:hover,
	.filter-btn:focus-visible,
	.sort-btn:hover,
	.sort-btn:focus-visible,
	.filter-btn.active,
	.sort-btn.active {
		border-color: var(--studio-ink);
		background: var(--studio-accent);
		color: var(--studio-ink);
		outline: none;
	}

	.challenge-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(38px, 5vw, 76px) clamp(14px, 2.8vw, 38px);
		padding-bottom: clamp(100px, 14vw, 190px);
	}

	.challenge-card {
		display: block;
		min-width: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.challenge-card:nth-child(3n + 2) {
		transform: translateY(56px);
	}

	.challenge-card:focus-visible {
		outline: 3px solid var(--studio-accent);
		outline-offset: 6px;
	}

	.challenge-image {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		border: 1px solid var(--studio-line);
		background: var(--studio-paper);
		box-shadow: 6px 6px 0 var(--studio-ink);
	}

	.challenge-image::after {
		position: absolute;
		inset: 0;
		background: linear-gradient(160deg, transparent 45%, rgba(9, 9, 8, 0.62));
		content: "";
		pointer-events: none;
	}

	.challenge-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: none;
		transition: filter 180ms ease, transform 260ms ease;
	}

	.challenge-card:hover .challenge-image img,
	.challenge-card:focus-visible .challenge-image img {
		filter: saturate(1) contrast(1.02);
		transform: scale(1.03);
	}

	.challenge-image b {
		position: absolute;
		right: 12px;
		bottom: 0;
		z-index: 2;
		color: var(--studio-ink);
		background: var(--studio-accent);
		padding: 4px 10px;
		font-family: var(--font-brand);
		font-size: clamp(2.6rem, 4.5vw, 4.5rem);
		font-weight: var(--font-brand-weight);
		letter-spacing: var(--tracking-heading);
		line-height: 1;
	}

	.challenge-copy {
		position: relative;
		display: block;
		min-height: 138px;
		padding: 18px 32px 18px 0;
		border-bottom: 1px solid var(--studio-line);
	}

	.challenge-copy small {
		display: block;
		color: var(--studio-ink);
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.75rem;
	}

	.challenge-copy strong {
		display: block;
		margin-top: 15px;
		color: var(--studio-ink);
		font-family: var(--font-body);
		font-size: clamp(1.05rem, 1.6vw, 1.4rem);
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1.35;
		overflow-wrap: anywhere;
	}

	.challenge-copy i {
		position: absolute;
		right: 0;
		bottom: 18px;
		font-family: "IBM Plex Mono", monospace;
		font-size: 1.2rem;
		font-style: normal;
	}

	.no-results {
		padding: 100px 20px;
		border-top: 2px solid var(--studio-ink);
		text-align: center;
	}

	.no-results[hidden] {
		display: none;
	}

	.no-results strong {
		color: var(--studio-ink);
		font-family: var(--font-brand);
		font-size: clamp(1.75rem, 5vw, 5rem);
		font-weight: var(--font-brand-weight);
		letter-spacing: var(--tracking-heading);
		line-height: 1.3;
		overflow-wrap: anywhere;
	}

	.no-results p {
		margin-top: 18px;
		color: var(--studio-muted);
	}

	.challenge-modal[hidden] {
		display: none;
	}

	.challenge-modal {
		position: fixed;
		inset: 0;
		z-index: 1000;
		display: grid;
		place-items: center;
		overflow-y: auto;
		padding: clamp(12px, 4vw, 48px);
		background: rgba(0, 0, 0, 0.9);
	}

	.modal-panel {
		position: relative;
		width: min(900px, 100%);
		max-height: calc(100vh - 32px);
		overflow-y: auto;
		padding: clamp(54px, 7vw, 90px) clamp(22px, 6vw, 72px);
		border: 2px solid var(--studio-ink);
		background: var(--studio-paper);
		box-shadow: 10px 10px 0 var(--studio-accent);
		color: var(--studio-ink);
	}

	.modal-close {
		position: absolute;
		top: 14px;
		right: 14px;
		padding: 8px 0;
		border: 0;
		border-bottom: 2px solid var(--studio-accent);
		border-radius: 0;
		background: transparent;
		color: var(--studio-ink);
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.75rem;
		font-weight: 600;
		cursor: pointer;
	}

	.modal-day-badge {
		color: var(--studio-ink);
		font-family: var(--font-brand);
		font-size: clamp(3rem, 8vw, 7rem);
		font-weight: var(--font-brand-weight);
		letter-spacing: var(--tracking-heading);
		line-height: 1;
	}

	.modal-date,
	.modal-category {
		color: var(--studio-muted);
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.78rem;
	}

	.modal-title {
		margin: 34px 0 22px;
		color: var(--studio-ink);
		font-family: var(--font-body);
		font-size: clamp(2.1rem, 5.5vw, 5.4rem);
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1.35;
		overflow-wrap: anywhere;
	}

	.modal-summary {
		color: var(--studio-ink);
		font-size: 1rem;
		line-height: 1.9;
	}

	.grok-comment-section {
		display: grid;
		grid-template-columns: 76px minmax(0, 1fr);
		gap: 20px;
		margin-top: 42px;
		padding: 24px 0;
		border-top: 1px solid var(--studio-line);
		border-bottom: 1px solid var(--studio-line);
	}

	.grok-avatar {
		width: 76px;
		aspect-ratio: 1;
		overflow: hidden;
		border: 1px solid var(--studio-line);
	}

	.grok-avatar img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.grok-name {
		margin-bottom: 8px;
		color: var(--studio-ink);
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
	}

	.grok-message {
		color: var(--studio-ink);
		line-height: 1.75;
	}

	@media (max-width: 1080px) {
		.archive-controls {
			position: static;
			grid-template-columns: 1fr;
		}

		.challenge-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.challenge-card:nth-child(3n + 2) {
			transform: none;
		}

		.challenge-card:nth-child(even) {
			transform: translateY(42px);
		}
	}

	@media (max-width: 680px) {
		.challenge-overview {
			grid-template-columns: 1fr;
		}

		.challenge-grid {
			grid-template-columns: 1fr;
			gap: 52px;
		}

		.challenge-card:nth-child(even) {
			transform: none;
		}

		.filter-group,
		.sort-group {
			align-items: stretch;
		}

		.filter-group > span,
		.sort-group > span {
			flex-basis: 100%;
		}

		.filter-btn,
		.sort-btn {
			flex: 1 1 auto;
		}

		.grok-comment-section {
			grid-template-columns: 54px minmax(0, 1fr);
		}

		.grok-avatar {
			width: 54px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.challenge-image img {
			transition: none;
		}
	}
</style>

<script>
	function initializeArchive() {
	const grid = document.getElementById('cardsGrid');
	if (!grid || grid.dataset.initialized === 'true') return;
	grid.dataset.initialized = 'true';
	const controller = new AbortController();
	const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
	const cardsGrid = document.getElementById('cardsGrid') as HTMLElement | null;
	const noResults = document.getElementById('noResults') as HTMLElement | null;
	const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const sortButtons = document.querySelectorAll<HTMLButtonElement>('.sort-btn');
	const modal = document.getElementById('modal') as HTMLElement | null;
	const modalClose = document.getElementById('modalClose') as HTMLButtonElement | null;
	const modalBody = document.getElementById('modalBody') as HTMLElement | null;
	let lastTrigger: HTMLButtonElement | null = null;
	let currentCategory = 'all';
	let currentSort = 'asc';

	function filterAndSort() {
		if (!searchInput || !cardsGrid || !noResults) return;
		const searchTerm = searchInput.value.toLowerCase().trim();
		const cards = Array.from(cardsGrid.querySelectorAll<HTMLButtonElement>('.challenge-card'));
		let visibleCount = 0;

		cards.forEach((card) => {
			const category = card.dataset.category || '';
			const title = card.dataset.title || '';
			const summary = card.dataset.summary || '';
			const visible = (currentCategory === 'all' || category === currentCategory)
				&& (!searchTerm || title.includes(searchTerm) || summary.includes(searchTerm));
			card.hidden = !visible;
			if (visible) visibleCount += 1;
		});

		cards
			.sort((a, b) => {
				const dayA = Number(a.dataset.day || 0);
				const dayB = Number(b.dataset.day || 0);
				return currentSort === 'asc' ? dayA - dayB : dayB - dayA;
			})
			.forEach((card) => cardsGrid.appendChild(card));

		noResults.hidden = visibleCount !== 0;
	}

	filterButtons.forEach((button) => {
		button.addEventListener('click', () => {
			filterButtons.forEach((item) => {
				item.classList.remove('active');
				item.setAttribute('aria-pressed', 'false');
			});
			button.classList.add('active');
			button.setAttribute('aria-pressed', 'true');
			currentCategory = button.dataset.category || 'all';
			filterAndSort();
		});
	});

	sortButtons.forEach((button) => {
		button.addEventListener('click', () => {
			sortButtons.forEach((item) => {
				item.classList.remove('active');
				item.setAttribute('aria-pressed', 'false');
			});
			button.classList.add('active');
			button.setAttribute('aria-pressed', 'true');
			currentSort = button.dataset.sort || 'asc';
			filterAndSort();
		});
	});

	searchInput?.addEventListener('input', filterAndSort);

	function closeModal() {
		if (!modal || !modalBody) return;
		modal.hidden = true;
		document.body.style.overflow = '';
		modalBody.innerHTML = '';
		lastTrigger?.focus();
	}

	function showModal(trigger: HTMLButtonElement) {
		if (!modal || !modalBody || !modalClose) return;
		lastTrigger = trigger;
		const day = Number(trigger.dataset.day || 0);
		const date = trigger.dataset.date || '';
		const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]!));
		const title = escapeHtml(trigger.dataset.modalTitle || '');
		const summary = escapeHtml(trigger.dataset.modalSummary || '');
		const category = trigger.dataset.category || '';
		const grokComment = escapeHtml(trigger.dataset.grokComment || '');
		const grokEmotion = trigger.dataset.grokEmotion || 'naruhodo';
		const grokAvatars = {
			huh: '/images/100days/grok/huh.webp',
			naruhodo: '/images/100days/grok/naruhodo.webp',
			interesting: '/images/100days/grok/interesting.webp',
			h: '/images/100days/grok/h.webp',
		};
		const grokAvatar = grokAvatars[grokEmotion as keyof typeof grokAvatars] || grokAvatars.naruhodo;
		modalBody.innerHTML = `
			<div class="modal-day-badge">${String(day).padStart(3, '0')} / 100</div>
			<div class="modal-date">${date.replaceAll('-', '.')}</div>
			<h2 class="modal-title" id="modal-title">${title}</h2>
			<p class="modal-summary">${summary}</p>
			<div class="modal-category">${category.toUpperCase()}</div>
			<div class="grok-comment-section">
				<div class="grok-avatar"><img src="${grokAvatar}" alt="Grok" /></div>
				<div><div class="grok-name">GROK'S COMMENT</div><div class="grok-message">${grokComment}</div></div>
			</div>
		`;

		modal.hidden = false;
		document.body.style.overflow = 'hidden';
		modalClose.focus();
	}

	document.querySelectorAll<HTMLButtonElement>('.challenge-card').forEach((card) => {
		card.addEventListener('click', () => {
			showModal(card);
		});
	});

	modalClose?.addEventListener('click', closeModal);
	modal?.addEventListener('click', (event) => {
		if (event.target === modal) closeModal();
	});
	window.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && modal && !modal.hidden) closeModal();
		if (event.key === 'Tab' && modal && !modal.hidden) {
			event.preventDefault();
			modalClose?.focus();
		}
	}, { signal: controller.signal });
	document.addEventListener('astro:before-swap', () => {
		controller.abort();
		document.body.style.overflow = '';
	}, { once: true, signal: controller.signal });
	}
	initializeArchive();
	document.addEventListener('astro:page-load', initializeArchive);
</script>
