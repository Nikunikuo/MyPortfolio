---
import CreatorContactStrip from '../components/CreatorContactStrip.astro';
import CreatorLayout from '../layouts/CreatorLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import YouTubeArchiveLink from '../components/YouTubeArchiveLink.astro';
import { videoArchive, youtubeWatchUrl } from '../data/videoArchive';

const title = '映像作品アーカイブ | 大鹿ニク';
const description = '大鹿ニクのアニメーション、短編、ミュージックビデオをピックアップ。気になる作品からYouTubeでご覧いただけます。';
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: '映像作品アーカイブ',
	description,
	url: 'https://niku.studio/video-archive/',
	mainEntity: {
		'@type': 'ItemList',
		numberOfItems: videoArchive.length,
		itemListElement: videoArchive.map((video, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			item: {
				'@type': 'VideoObject',
				name: video.title,
				description: video.description,
				embedUrl: `https://www.youtube.com/embed/${video.id}`,
				thumbnailUrl: `https://i.ytimg.com/vi/${video.id}/${video.thumbnail ?? 'hqdefault'}.jpg`,
				url: youtubeWatchUrl(video.id),
			},
		})),
	},
};
---

<CreatorLayout
	title={title}
	description={description}
	eyebrow="VIDEO / ARCHIVE"
	heading="映像作品アーカイブ"
	intro="アニメーション、短編、音楽の映像。気になる一本を見つけたら、YouTubeへ。"
	number="05"
	backHref="/work/"
	backLabel="その他制作物の倉庫"
	structuredData={structuredData}
>
	<div class="archive-intro">
		<YouTubeArchiveLink />
		<nav class="archive-related" aria-label="ほかの作品ページ">
			<span>{String(videoArchive.length).padStart(2, '0')} WORKS / PICK UP</span>
			<div>
				<a href="/work/music-videos/">Music Videos <span aria-hidden="true">→</span></a>
				<a href="/hami-preview/">ハミちゃんの日常飯 <span aria-hidden="true">→</span></a>
			</div>
		</nav>
	</div>

	<section class="archive-grid" aria-label="映像作品一覧">
		{videoArchive.map((video, index) => <VideoCard video={video} index={index} />)}
	</section>

	<YouTubeArchiveLink />
	<CreatorContactStrip />
</CreatorLayout>

<style>
	.archive-intro { margin-bottom: 42px; }
	.archive-related { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 18px 30px; padding-block: 24px; border-bottom: 2px solid var(--studio-ink); }
	.archive-related > span { font-family: "IBM Plex Mono", monospace; font-size: 12px; font-weight: 600; }
	.archive-related > div { display: flex; flex-wrap: wrap; gap: 18px 26px; }
	.archive-related a { display: inline-flex; gap: 14px; padding-block: 5px; color: inherit; font-size: 14px; font-weight: 700; text-underline-offset: 5px; }
	.archive-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 52px 38px; padding: 0 5px clamp(60px, 8vw, 120px) 0; }
	@media (max-width: 680px) { .archive-grid { grid-template-columns: minmax(0, 1fr); gap: 38px; } }
</style>
