---
import HamiImage from '../../../components/hami/HamiImage.astro';

const canonicalPath = '/hami-preview/fanworks/';
const siteUrl = Astro.site ?? new URL('https://niku.studio');
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const pageTitle = '二次創作ガイドライン | ハミちゃんの日常飯';
const pageDescription =
	'「ハミちゃんの日常飯」のファンアート、漫画、小説、動画、配信、同人頒布、AI生成作品などに関する二次創作ガイドラインです。';
const ogImageUrl = new URL('/images/hami/gekikara-card.png', siteUrl).toString();

const quickGuide = [
	{
		tone: 'ok',
		label: 'OK',
		title: 'そのまま楽しめます',
		items: [
			'個人によるファンアート、漫画、小説、動画、配信、ゲーム、音楽、コスプレ',
			'投稿先の規約を守った動画広告収益や配信収益',
			'個人が趣味の範囲で行う、少部数・小規模な同人頒布',
			'AI生成・AI補助であることを明記したファン作品',
		],
	},
	{
		tone: 'ask',
		label: 'ASK',
		title: '公開前にご相談ください',
		items: [
			'法人・団体による利用、企業案件、スポンサー付き企画',
			'継続的な商品展開、大量生産、店舗流通、クラウドファンディング',
			'公式コラボや公式商品と受け取られる可能性がある企画',
			'このページを読んでも判断に迷う利用',
		],
	},
	{
		tone: 'ng',
		label: 'NG',
		title: '行わないでください',
		items: [
			'公式作品・公式商品・公式発表と誤認させる表示や販売',
			'本編、公式画像、ロゴ、音声、設定資料の転載・再配布・販売',
			'第三者の権利やプライバシーを侵害する利用',
			'差別、ヘイト、勧誘、攻撃的主張などへの利用',
		],
	},
];

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebPage',
			'@id': canonicalUrl,
			url: canonicalUrl,
			name: pageTitle,
			description: pageDescription,
			inLanguage: 'ja-JP',
			isPartOf: {
				'@type': 'WebSite',
				'@id': 'https://niku.studio/#website',
				url: new URL('/', siteUrl).toString(),
				name: 'Niku’s Portfolio',
			},
			about: {
				'@type': 'TVSeries',
				name: 'ハミちゃんの日常飯',
				url: new URL('/hami-preview/', siteUrl).toString(),
			},
			datePublished: '2026-07-19',
			dateModified: '2026-07-19',
		},
		{
			'@type': 'FAQPage',
			mainEntity: [
				{
					'@type': 'Question',
					name: 'ハミちゃんの日常飯の二次創作をしてもよいですか？',
					acceptedAnswer: {
						'@type': 'Answer',
						text: '個人によるファンアート、漫画、小説、動画、配信、ゲーム、音楽、コスプレなどを歓迎しています。公式作品と誤認されないよう、二次創作であることを明記してください。',
					},
				},
				{
					'@type': 'Question',
					name: 'AIを使った二次創作はできますか？',
					acceptedAnswer: {
						'@type': 'Answer',
						text: '画像・動画・文章・音楽などのAI生成またはAI補助による二次創作を認めています。公開時には、可能な範囲でAI生成またはAI補助であることを明記してください。',
					},
				},
				{
					'@type': 'Question',
					name: '二次創作を収益化できますか？',
					acceptedAnswer: {
						'@type': 'Answer',
						text: '動画や配信の広告収益、個人による少部数・小規模な同人頒布は可能です。法人利用、継続的な商品展開、大量生産、店舗流通などは事前にご相談ください。',
					},
				},
			],
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{
					'@type': 'ListItem',
					position: 1,
					name: 'Niku’s Portfolio',
					item: new URL('/', siteUrl).toString(),
				},
				{
					'@type': 'ListItem',
					position: 2,
					name: 'ハミちゃんの日常飯',
					item: new URL('/hami-preview/', siteUrl).toString(),
				},
				{
					'@type': 'ListItem',
					position: 3,
					name: '二次創作ガイドライン',
					item: canonicalUrl,
				},
			],
		},
	],
};
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={pageDescription} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="theme-color" content="#ef765f" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/images/hami/steak-favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;700;800;900&family=Yomogi&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="ハミちゃんの日常飯" />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1280" />
		<meta property="og:image:height" content="720" />
		<meta property="og:image:alt" content="ハミちゃん、ミルちゃん、あくたんが激辛ラーメンを囲むハミちゃんの日常飯のキービジュアル" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">本文へ移動</a>
		<header class="fan-header">
			<div class="fan-header__inner">
				<a class="fan-brand" href="/hami-preview/" aria-label="ハミちゃんの日常飯 特設サイトへ">
					<span class="fan-brand__stamp" aria-hidden="true">創</span>
					<span><strong>ハミちゃんの日常飯</strong><small>FANWORK GUIDELINES</small></span>
				</a>
				<nav class="fan-nav" aria-label="二次創作ガイドライン">
					<a href="#quick-check">早見表</a>
					<a href="#ai">AI生成</a>
					<a href="#monetization">収益化</a>
					<a href="#prohibited">禁止事項</a>
					<a href="/hami-preview/">特設トップ</a>
				</nav>
			</div>
		</header>

		<main id="main-content">
			<section class="fan-hero" aria-labelledby="fanwork-title">
				<div class="fan-hero__copy">
					<p class="eyebrow">FANWORK GUIDELINES</p>
					<h1 id="fanwork-title">二次創作、<br />おかわり大歓迎です。</h1>
					<p>
						ハミちゃん、ミルちゃん、あくたんを好きになってくれた気持ちから生まれる、
						イラスト、漫画、小説、動画、配信、<span class="phrase-keep">AI作品などを歓迎します。</span>
					</p>
					<a class="utensil-link" href="#quick-check">まず早見表を確認する</a>
				</div>
				<div class="fan-hero__characters" aria-hidden="true">
					<HamiImage src="/images/hami/character-lineup.avif" alt="" />
				</div>
			</section>

			<section class="policy-intro content-shell" aria-labelledby="policy-intro-title">
				<div>
					<p class="section-kicker">WELCOME TO THE TABLE</p>
					<h2 id="policy-intro-title">好きの気持ちを、安心して作品に。</h2>
				</div>
				<div class="policy-intro__copy">
					<p>
						このページは、「ハミちゃんの日常飯」の二次創作を気持ちよく楽しんでもらうためのガイドラインです。
						個人・同人による創作を基本的に歓迎しています。
					</p>
					<p>
						ガイドラインは作品や公式運用に合わせて更新される場合があります。公開・頒布するときは、
						その時点の内容をご確認ください。法人利用や判断に迷う企画は、公開前に公式へご相談ください。
					</p>
				</div>
			</section>

			<section class="quick-check content-shell" id="quick-check" aria-labelledby="quick-check-title">
				<header class="section-heading">
					<div>
						<p class="section-kicker">QUICK CHECK</p>
						<h2 id="quick-check-title">迷ったら、まずここ。</h2>
					</div>
					<p>個人のファン活動か、公式に見える事業利用かが大きな境目です。</p>
				</header>
				<div class="quick-grid">
					{quickGuide.map((group) => (
						<article class:list={['quick-card', `quick-card--${group.tone}`]}>
							<div class="quick-card__mark" aria-hidden="true">{group.label}</div>
							<h3>{group.title}</h3>
							<ul>
								{group.items.map((item) => <li>{item}</li>)}
							</ul>
						</article>
					))}
				</div>
			</section>

			<div class="guideline-stack">
				<section class="guideline-band" id="basics" aria-labelledby="basics-title">
					<div class="guideline-band__inner">
						<header class="guideline-title">
							<span aria-hidden="true">01</span>
							<p>BASIC POLICY</p>
							<h2 id="basics-title">基本方針</h2>
						</header>
						<div class="guideline-copy">
							<ul>
								<li>個人・同人による二次創作を歓迎します。媒体や制作方法は問いません。</li>
								<li>作品に描かれていない部分は、公式設定として断定せず「二次創作上の解釈」としてお楽しみください。</li>
								<li>投稿や頒布の際は、公式作品ではなく二次創作であることが分かるようにしてください。</li>
								<li>投稿先、イベント、販売サービスの規約や年齢区分もあわせて守ってください。</li>
							</ul>
							<p class="note-strip">キャラクターへの敬意と、「おいしい、うれしい、ちょっとおかしい」空気を大切にしてもらえたらうれしいです。</p>
						</div>
					</div>
				</section>

				<section class="guideline-band guideline-band--mint" id="formats" aria-labelledby="formats-title">
					<div class="guideline-band__inner">
						<header class="guideline-title">
							<span aria-hidden="true">02</span>
							<p>WELCOME FANWORKS</p>
							<h2 id="formats-title">歓迎する創作</h2>
						</header>
						<div class="guideline-copy">
							<p>たとえば、次のような作品を歓迎しています。</p>
							<div class="format-list" aria-label="歓迎する二次創作の例">
								<span>イラスト</span><span>漫画</span><span>小説</span><span>動画</span>
								<span>配信</span><span>ゲーム</span><span>音楽</span><span>コスプレ</span>
								<span>料理再現</span><span>AI生成作品</span>
							</div>
							<p>
								実在する飲食店、食品メーカー、イベントとの公式タイアップであるように見せる表現は避けてください。
								ファンによる架空メニューや料理再現であることが分かれば問題ありません。
							</p>
						</div>
					</div>
				</section>

				<section class="guideline-band guideline-band--sky" id="ai" aria-labelledby="ai-title">
					<div class="guideline-band__inner">
						<header class="guideline-title">
							<span aria-hidden="true">03</span>
							<p>AI-ASSISTED WORKS</p>
							<h2 id="ai-title">AI生成について</h2>
						</header>
						<div class="guideline-copy">
							<ul>
								<li>画像、動画、文章、音楽など、AI生成・AI補助による二次創作を認めています。</li>
								<li>公開時は、可能な範囲で「AI生成」「AI補助」など、制作方法が分かる表記を添えてください。</li>
								<li>AIを使った場合も、公開した作品の内容や権利処理については投稿者が責任を持ってください。</li>
								<li>権利を持たない第三者作品や、再利用を認めていない素材を無断で利用しないでください。</li>
								<li>公式画像・音声・設定資料をまとめた学習用データ、素材集、モデルなどの配布・販売は認めていません。</li>
							</ul>
							<p class="note-strip">生成方法にかかわらず、公式作品と誤認される表示や、キャラクターの信用を大きく損なう利用は同じく対象外です。</p>
						</div>
					</div>
				</section>

				<section class="guideline-band guideline-band--yellow" id="monetization" aria-labelledby="monetization-title">
					<div class="guideline-band__inner">
						<header class="guideline-title">
							<span aria-hidden="true">04</span>
							<p>MONETIZATION</p>
							<h2 id="monetization-title">収益化・頒布</h2>
						</header>
						<div class="guideline-copy">
							<ul>
								<li>YouTube、配信サイト、SNSなどで、再生数や閲覧数に応じて発生する広告収益は問題ありません。</li>
								<li>個人が趣味の範囲で行う、同人イベントや通販での少部数・小規模な頒布を認めています。</li>
								<li>販売物は、ご自身で制作した表現を中心にしてください。公式画像、ロゴ、動画の切り抜きを主体にした商品化はできません。</li>
								<li>法人・団体での利用、企業案件、継続販売、大量生産、店舗流通、広告利用は事前にご相談ください。</li>
							</ul>
							<div class="consult-box">
								<strong>事前相談が必要な例</strong>
								<p>企業コラボ、食品や店舗とのタイアップ、クラウドファンディング、公式商品と並ぶ規模の販売、ライセンス利用。</p>
							</div>
						</div>
					</div>
				</section>

				<section class="guideline-band guideline-band--coral" id="prohibited" aria-labelledby="prohibited-title">
					<div class="guideline-band__inner">
						<header class="guideline-title">
							<span aria-hidden="true">05</span>
							<p>PLEASE DO NOT</p>
							<h2 id="prohibited-title">禁止事項</h2>
						</header>
						<div class="guideline-copy">
							<ul>
								<li>公式作品、公式発表、公式商品、公式コラボであると誤認させること。</li>
								<li>本編動画の再投稿、長時間の無断転載、公式画像・ロゴ・音声・設定資料の再配布や販売。</li>
								<li>第三者の著作権、商標権、肖像権、名誉、プライバシーなどを侵害すること。</li>
								<li>差別、ヘイト、嫌がらせ、過度な暴力、現実の政治・宗教団体の宣伝、勧誘、攻撃的主張への利用。</li>
								<li>公開場所の年齢区分を守らない露骨な性的表現や、年齢を誤認させる性的表現。</li>
								<li>ハミちゃんの日常飯、登場人物、制作関係者の信用を大きく損なう利用。</li>
							</ul>
							<p class="note-strip">感想・レビュー・紹介に必要な範囲の引用は、引用部分とご自身の表現を明確に分け、各サービスの規約と法律に従ってください。</p>
						</div>
					</div>
				</section>

				<section class="guideline-band guideline-band--paper" id="credit" aria-labelledby="credit-title">
					<div class="guideline-band__inner">
						<header class="guideline-title">
							<span aria-hidden="true">06</span>
							<p>CREDIT & HASHTAG</p>
							<h2 id="credit-title">表記について</h2>
						</header>
						<div class="guideline-copy">
							<ul>
								<li>作品名や投稿文に「ハミちゃんの日常飯の二次創作」「ファン作品」などの表記を添えてください。</li>
								<li>特設サイトやYouTube再生リストへのリンクは任意ですが、作品を知る入口として歓迎します。</li>
								<li>ハッシュタグを付ける場合は、下記の推奨タグをご利用ください。</li>
							</ul>
							<div class="hashtag-plate">
								<small>RECOMMENDED HASHTAG</small>
								<strong>#ハミちゃんの日常飯</strong>
								<p>ファン作品を見つけに行きやすくなります。</p>
							</div>
						</div>
					</div>
				</section>
			</div>

			<section class="closing-band">
				<div>
					<p class="section-kicker">THANK YOU FOR CREATING</p>
					<h2>あなたの一皿も、<br class="mobile-only-break" />楽しみにしています。</h2>
					<p>描く、書く、作る、演じる。いろいろな形の「好き」が、三人の日常をもっと広げてくれます。</p>
				</div>
				<nav aria-label="関連ページ">
					<a class="utensil-link utensil-link--light" href="/hami-preview/">特設サイトへ戻る</a>
					<a class="utensil-link utensil-link--light" href="/hami-preview/recipes/">全14品のレシピ</a>
				</nav>
			</section>
		</main>

		<footer class="fan-footer">
			<div><strong>ハミちゃんの日常飯</strong><p>おいしい、うれしい、ちょっとおかしい。</p></div>
			<nav aria-label="Footer navigation">
				<a href="/hami-preview/">特設トップ</a>
				<a href="/hami-preview/recipes/">レシピ</a>
				<a href="/">Niku's Portfolio</a>
			</nav>
			<small>&copy;ハミちゃんの日常飯</small>
		</footer>
	</body>
</html>

<style>
	:root {
		--ink: #402e28;
		--muted: #77655d;
		--cream: #fff8ec;
		--paper: #fffdf8;
		--coral: #ef765f;
		--coral-dark: #b84334;
		--yellow: #f8c85a;
		--mint: #9bcdbf;
		--sky: #9ed8f7;
		--chocolate: #5d3527;
		--charcoal: #282326;
		--line: #eadbc9;
		font-family: "M PLUS Rounded 1c", "Yu Gothic", "Meiryo", sans-serif;
		color: var(--ink);
		background: var(--cream);
	}

	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; scroll-padding-top: 5.5rem; }
	body {
		margin: 0;
		min-width: 320px;
		background:
			linear-gradient(rgba(255, 248, 236, 0.9), rgba(255, 248, 236, 0.9)),
			url("/images/hami/cutlery-pattern.svg");
		background-attachment: fixed;
		cursor: url("/images/hami/fork-cursor.svg") 10 10, auto;
	}

	a { color: inherit; cursor: url("/images/hami/fork-cursor.svg") 10 10, pointer; }
	img { display: block; max-width: 100%; height: auto; }
	h1, h2, h3, p, ul { margin-top: 0; }
	h1, h2, h3 { letter-spacing: 0; }
	p, li { line-height: 1.85; }
	:focus-visible { outline: 4px solid #0f6f7a; outline-offset: 4px; }
	section[id] { scroll-margin-top: 5.5rem; }

	.skip-link {
		position: fixed;
		left: 0.75rem;
		top: 0.75rem;
		z-index: 200;
		padding: 0.65rem 0.9rem;
		background: var(--charcoal);
		color: #fff;
		transform: translateY(-180%);
		transition: transform 160ms ease;
	}
	.skip-link:focus { transform: none; }

	.fan-header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid rgba(64, 46, 40, 0.12);
		background: rgba(255, 253, 248, 0.93);
		backdrop-filter: blur(18px);
	}
	.fan-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(78rem, calc(100% - 2rem));
		min-height: 4.75rem;
		margin: 0 auto;
		gap: 1.5rem;
	}
	.fan-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
	}
	.fan-brand__stamp {
		display: grid;
		place-items: center;
		width: 2.8rem;
		aspect-ratio: 1;
		border: 2px solid var(--chocolate);
		border-radius: 8px;
