const youtubePlaylistId = 'PLQowZoIyUibREBdE8UuNSy5B2t5l7RFOi';
const youtubePlaylistUrl = `https://www.youtube.com/playlist?list=${youtubePlaylistId}`;
const youtubeWatchUrl = (videoId, playlistIndex) =>
	`https://www.youtube.com/watch?v=${videoId}&list=${youtubePlaylistId}&index=${playlistIndex}`;

