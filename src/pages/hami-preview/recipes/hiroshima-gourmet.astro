---
import HamiImage from '../../../components/hami/HamiImage.astro';
import HamiRecipeLayout from '../../../layouts/HamiRecipeLayout.astro';

const canonicalPath = '/hami-preview/recipes/hiroshima-gourmet/';
const title = '広島編の食べもの案内 | ハミちゃんの日常飯';
const description =
	'「ハミちゃんの日常飯」特別編・広島旅行に登場する、もみじ饅頭、広島お好み焼き、焼き牡蠣、あなごめしを紹介する、つくり方ではない作中グルメ案内です。';
const youtubeVideoId = 'Xnjtw6az0L8';
const youtubeUrl = `https://www.youtube.com/watch?v=${youtubeVideoId}&list=PLQowZoIyUibREBdE8UuNSy5B2t5l7RFOi&index=19`;
const siteUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const heroImageUrl = new URL('/images/hami/hiroshima/hiroshima-trip.avif', siteUrl).href;
const youtubeThumbnailUrl = new URL('/images/hami/hiroshima/hiroshima-youtube-thumbnail.jpg', siteUrl).href;

const foods = [
	{
		id: 'momiji-manju',
		order: '01',
		day: 'DAY 1 · 宮島の小休止',
		name: 'もみじ饅頭',
		image: '/images/hami/hiroshima/momiji-manju.avif',
		description: 'もみじの形をした広島・宮島のお菓子。広島編では、散策の途中でハミが思わず顔をほころばせる、あたたかな寄り道です。',
		point: '紙袋、焼き型、熱さに気をつける一口。甘味は旅の主役を急がせない、小さな休憩として登場します。',
		quote: 'ハミ「 あまくて、あったかい……！ 」',
	},
	{
		id: 'okonomiyaki',
		order: '02',
		day: 'DAY 1 · 広島市内の昼',
		name: '広島お好み焼き',
		image: '/images/hami/hiroshima/okonomiyaki-teppan.avif',
		description: '生地、キャベツ、麺、卵、ソースを重ねて鉄板で焼く、広島らしい一皿。三人が同じ鉄板を囲む、Day 1いちばん大きな食の場面です。',
		point: 'ジュウッという音、ヘラ、湯気。食後には鉄板のソース跡まで残して、にぎやかな昼をほどきます。',
		quote: 'ハミ「 音だけでもう、おいしい！ 」',
	},
	{
		id: 'grilled-oysters',
		order: '03',
		day: 'DAY 2 · 朝の宮島',
		name: '焼き牡蠣',
		image: '/images/hami/hiroshima/grilled-oysters.avif',
		description: '殻のまま火にかけ、開いたところを楽しむ牡蠣。朝の海風と一緒に、あくたんが「食べる側」に戻る短い場面です。',
		point: '火、殻、水分、開く音。熱さを少し待ってからの一口が、朝の軽さをつくります。',
		quote: 'あくたん「 ……うま 」',
	},
	{
		id: 'anago-meshi',
		order: '04',
		day: 'DAY 2 · ふたを開ける昼',
		name: 'あなごめし',
		image: '/images/hami/hiroshima/anago-meshi.avif',
		description: '香ばしいあなごとごはんを重ねた、宮島周辺で親しまれる一皿。広島編では、ミルがふたを開ける瞬間から、静かな食欲が動き出します。',
		point: '待つ時間、ふた、湯気、照り、最初の一口。お好み焼きとは別の、しずかな満腹を描く主食です。',
		quote: 'ミル「 ……これ。 」',
	},
];

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'CollectionPage',
			'@id': canonicalUrl,
			url: canonicalUrl,
			name: title,
			description,
			inLanguage: 'ja-JP',
			primaryImageOfPage: heroImageUrl,
			mainEntity: {
				'@type': 'ItemList',
				itemListElement: foods.map((food, index) => ({
					'@type': 'ListItem',
					position: index + 1,
					name: food.name,
					url: `${canonicalUrl}#${food.id}`,
				})),
			},
		},
		{
			'@type': 'VideoObject',
			'@id': `${canonicalUrl}#video`,
			name: 'ハミちゃんの日常飯　特別編　広島旅行【グルメアニメ❤本編】',
			description,
			url: youtubeUrl,
			embedUrl: `https://www.youtube.com/embed/${youtubeVideoId}`,
			thumbnailUrl: [youtubeThumbnailUrl],
			inLanguage: 'ja-JP',
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{
					'@type': 'ListItem',
					position: 1,
					name: 'ハミちゃんの日常飯',
					item: new URL('/hami-preview/', siteUrl).href,
				},
				{
					'@type': 'ListItem',
					position: 2,
					name: 'おうち再現レシピ',
					item: new URL('/hami-preview/recipes/', siteUrl).href,
				},
				{
					'@type': 'ListItem',
					position: 3,
					name: '広島編の食べもの案内',
					item: canonicalUrl,
				},
			],
		},
	],
};
---

<HamiRecipeLayout
	{title}
	{description}
	{canonicalPath}
	ogImage="/images/hami/hiroshima/hiroshima-trip.avif"
	{structuredData}
	brandSubtitle="広島旅行・食べもの案内"
	navigationLabel="広島編の案内"
	navigationLinks={[
		{ href: '/hami-preview/hiroshima/', label: '広島特別編' },
		{ href: '/hami-preview/recipes/', label: 'レシピ一覧' },
		{ href: '/hami-preview/', label: '特設トップ' },
	]}
	footerTagline="旅で出会った四つの味を、物語のままもう一度。"
>
	<section class="hiroshima-guide-hero">
		<div class="hiroshima-guide-hero__copy">
			<p class="eyebrow">FOODS IN THE HIROSHIMA SPECIAL</p>
			<h1>つくり方ではなく、<br /><em>旅で出会う味。</em></h1>
			<p>
				ここは、家庭向けの分量や手順を置くレシピページではありません。
				広島特別編に出てくる四つの食べものを、場面の空気ごとに紹介する小さな案内です。
			</p>
			<div class="hiroshima-guide-hero__actions">
				<a class="pill-button pill-button--coral" href="/hami-preview/hiroshima/">特別編のページへ <span aria-hidden="true">→</span></a>
				<a class="text-link" href={youtubeUrl} target="_blank" rel="noreferrer">YouTubeで本編を見る <span aria-hidden="true">↗</span></a>
			</div>
		</div>
		<figure class="hiroshima-guide-hero__visual">
			<HamiImage
				src="/images/hami/hiroshima/hiroshima-trip.avif"
				alt="広島旅行で四つの食べものを楽しむハミちゃん、ミルちゃん、あくたん"
				fetchpriority="high"
			/>
		</figure>
	</section>

	<section class="hiroshima-guide recipe-container" aria-labelledby="hiroshima-guide-title">
		<header class="recipe-section-heading">
			<div>
				<p class="section-kicker">FOUR FOODS, FOUR MOMENTS</p>
				<h2 id="hiroshima-guide-title">広島編の食べもの</h2>
			</div>
			<p>食べる順番にも、三人らしい理由があります。</p>
		</header>

		<div class="hiroshima-guide__grid">
			{foods.map((food) => (
				<article class="hiroshima-guide-card" id={food.id}>
					<div class="hiroshima-guide-card__visual">
						<HamiImage src={food.image} alt={food.name} />
						<span>{food.order}</span>
					</div>
					<div class="hiroshima-guide-card__copy">
						<p class="section-kicker">{food.day}</p>
						<h3>{food.name}</h3>
						<p>{food.description}</p>
						<aside class="hiroshima-guide-card__point">
							<strong>ワンポイント</strong>
							<p>{food.point}</p>
						</aside>
						<blockquote><span>CHARACTER NOTE</span><p>{food.quote}</p></blockquote>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="hiroshima-ryokan-note recipe-container" aria-labelledby="hiroshima-ryokan-note-title">
		<div>
			<p class="section-kicker">A QUIET NIGHT</p>
			<h2 id="hiroshima-ryokan-note-title">旅館の夜ごはんは、<br />食べものの競争にしない。</h2>
		</div>
		<p>
			広島編には旅館での夕食もありますが、献立は作品づくりのための仮置きです。
			この案内では地域名物として断定せず、湯気やお茶、片付いた食器で旅の夜を感じる場面として大切にしています。
		</p>
	</section>

	<section class="hiroshima-watch-band">
		<div class="recipe-container hiroshima-watch-band__inner">
			<a class="hiroshima-watch-thumbnail" href={youtubeUrl} target="_blank" rel="noreferrer" aria-label="ハミちゃんの日常飯 特別編 広島旅行をYouTubeで見る">
				<img
					src="/images/hami/hiroshima/hiroshima-youtube-thumbnail.jpg"
					alt="YouTube動画「ハミちゃんの日常飯 特別編 広島旅行」のサムネイル"
					width="480"
					height="360"
					loading="lazy"
				/>
				<span aria-hidden="true">▶</span>
			</a>
			<div class="hiroshima-watch-band__copy">
				<p class="section-kicker">WATCH THE SPECIAL</p>
				<h2>味の続きは、<br />本編のなかへ。</h2>
				<p class="hiroshima-watch-band__title">ハミちゃんの日常飯　特別編　広島旅行【グルメアニメ❤本編】</p>
				<p>四つの味と三人の旅を、YouTube本編でどうぞ。</p>
				<a class="pill-button pill-button--cream" href={youtubeUrl} target="_blank" rel="noreferrer">
					広島特別編を見る <span aria-hidden="true">↗</span>
				</a>
			</div>
		</div>
	</section>
</HamiRecipeLayout>
