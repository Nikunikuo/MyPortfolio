---
import { getCollection } from "astro:content";
import CallToAction from "../components/CallToAction.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Grid from "../components/Grid.astro";
import HamiImage from "../components/hami/HamiImage.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import Pill from "../components/Pill.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("work"))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 6);

const homeStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	'@id': 'https://niku.studio/#featured-projects',
	name: 'Niku’s Portfolio Featured Projects',
	description: 'Niku’s Portfolioで公開している主要プロジェクトと特設ページ。',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			url: 'https://niku.studio/hami-preview/',
			name: 'ハミちゃんの日常飯',
			item: {
				'@type': 'CreativeWorkSeries',
				name: 'ハミちゃんの日常飯',
				url: 'https://niku.studio/hami-preview/',
				description:
					'ハミちゃん、ミルちゃん、あくたんが身近なごはんを囲み、かわいくて少しおかしい事件を起こす全13話の日常系ごはんアニメ。全話の家庭向けレシピも公開中。',
				image: 'https://niku.studio/images/hami/og-card.jpg',
				genre: ['日常系アニメ', '料理アニメ', 'ショートアニメ'],
				hasPart: {
					'@type': 'CollectionPage',
					name: 'ハミちゃんの日常飯 レシピ',
					url: 'https://niku.studio/hami-preview/recipes/',
				},
			},
		},
		{
			'@type': 'ListItem',
			position: 2,
			url: 'https://niku.studio/ghosts/',
			name: 'GHOSTS',
			item: {
				'@type': 'CreativeWorkSeries',
				name: 'GHOSTS',
				url: 'https://niku.studio/ghosts/',
				description: 'AI統治下の近未来で、音楽と感情を取り戻そうとする架空バンドプロジェクト。',
				genre: ['サイバーパンク', '音楽', 'アニメ', '漫画'],
			},
		},
		{
			'@type': 'ListItem',
			position: 3,
			url: 'https://niku.studio/100days/',
			name: '#AI創作100日チャレンジ',
			item: {
				'@type': 'CreativeWork',
				name: '#AI創作100日チャレンジ',
				url: 'https://niku.studio/100days/',
				description: '毎日AI創作を続けた100日間の記録。',
			},
		},
	],
};
---

<BaseLayout
	title="大鹿ニク / M1RA - AI×エンタメクリエイター"
	description="生成AIでMV・ショートムービーを制作。1～2週ごとに新作公開中。AITuber「M1RA」プロジェクト運営。AI技術で人間の創造性を解放し、哲学×AIの未来を体現する個人開発者のポートフォリオサイト。"
	showLoading={true}
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(homeStructuredData)} />

	<div class="stack gap-10 lg:gap-20">
		<div class="wrapper stack gap-8 lg:gap-20">
			<div class="site-title">
				<h1 class="title-main" data-i18n="site_title">
					Niku's Portfolio
				</h1>
				<p class="title-sub" data-i18n="site_subtitle">
					~ニクの秘密基地~
				</p>
			</div>
			<header class="hero">
				<div class="hero-image-container">
					<img
						alt="大鹿ニク - AI×エンタメの個人開発者"
						src="/images/top.png"
						class="hero-image"
					/>
					<div class="hero-text-overlay">
						<h1 class="hero-title" data-i18n="hero_name">
							大鹿ニク / M1RA
						</h1>
						<p class="hero-tagline" data-i18n="hero_tagline">
							AI技術で人間の創造性を解放する
						</p>
						<div class="roles">
							<Pill
								><Icon icon="code" size="1.33em" />
								<span data-i18n="hero_role_developer"
									>AI Developer</span
								></Pill
							>
							<Pill
								><Icon icon="rocket-launch" size="1.33em" />
								<span data-i18n="hero_role_creator"
									>Creator</span
								></Pill
							>
							<Pill
								><Icon icon="strategy" size="1.33em" />
								<span data-i18n="hero_role_aituber"
									>AITuber</span
								></Pill
							>
						</div>
					</div>
				</div>
			</header>

			<section class="intro-section">
				<div class="intro-layout">
					<div class="intro-content">
						<h2 data-i18n="intro_heading">
							生成AIでエンタメを創る
						</h2>
						<p data-i18n="intro_text">
							🎥
							生成AIでMV制作（1～2週ごとに投稿中）→ショートムービー等も作成中！<br
							/>
							🤖 AITuber「M1RA」プロジェクト運営 →「AIに心はあるのか」哲学×AIの体現<br
							/>
							💻 AI×エンタメの個人開発者 → vibe coding信者
						</p>
					</div>
					<div class="card-hand">
						<div class="card card-1">
							<img
								src="/images/card1.png"
								alt="大鹿ニクの作品コレクションのサムネイル。生成AIを活用したミュージックビデオ制作やAITuberプロジェクトのビジュアルが並んでいる"
							/>
						</div>
						<div class="card card-2">
							<img
								src="/images/card2.png"
								alt="M1RA Project Archiveのサムネイル。AIが「存在したい」と願う瞬間をテーマにした、哲学的かつ幻想的なビジュアルアート"
							/>
						</div>
						<div class="card card-3">
							<img
								src="/images/card3.png"
								alt="AI×エンタメの未来を表現したサムネイル。生成AI技術とクリエイティブの融合による、新しい表現の可能性を示唆する抽象的なグラフィック"
							/>
						</div>
					</div>
				</div>
				<div class="intro-videos">
					<Grid variant="offset">
						<li>
							<iframe
								src="https://www.youtube.com/embed/397bpH3HSfQ"
								title="YouTube video player"
								frameborder="0"
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
								allowfullscreen
								class="local-video"
								style="width: 100%; aspect-ratio: 16/9; border-radius: 0.5rem;"></iframe>
						</li>
						<li>
							<iframe
								src="https://www.youtube.com/embed/44LqD5FUGuw"
								title="YouTube video player"
								frameborder="0"
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
								allowfullscreen
								class="local-video"
								style="width: 100%; aspect-ratio: 16/9; border-radius: 0.5rem;"></iframe>
						</li>
						<li>
							<iframe
								src="https://www.youtube.com/embed/vose8t_6i-o"
								title="YouTube video player"
								frameborder="0"
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
								allowfullscreen
								class="local-video"
								style="width: 100%; aspect-ratio: 16/9; border-radius: 0.5rem;"></iframe>
						</li>
						<li>
							<iframe
								src="https://www.youtube.com/embed/jJ4IElboaIg"
								title="YouTube video player"
								frameborder="0"
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
								allowfullscreen
								class="local-video"
								style="width: 100%; aspect-ratio: 16/9; border-radius: 0.5rem;"></iframe>
						</li>
					</Grid>
				</div>
			</section>
		</div>
	</div>

	<main class="wrapper stack gap-10 lg:gap-20">
		<section class="section with-background with-cta">
			<header class="section-header stack gap-2 lg:gap-4">
				{/*
					[DEV] 更新情報の文言は更新頻度が高いため i18n.js 管理から外している。
					タイトル・説明・CTA を変えるときは、この index.astro だけを更新すればよい。
					画像は Lastest.png を差し替えるとビルド時ハッシュ付き URL でキャッシュ回避される。
				*/}
				<div class="section-title-wrapper">
					<h3>更新情報</h3>
					<img
						src={`/images/Lastest.png?v=${import.meta.env.PUBLIC_LATEST_WORKS_ICON_HASH}`}
						alt="更新情報セクションのアイコン。最新の制作実績を示す、スタイリッシュなデザインのグラフィック"
						class="section-icon"
					/>
				</div>
				<p>
					最新の制作実績。詳細は"Gallery"ページからご覧いただけます。（2026/4/28　お問合せページの作成。）
				</p>
			</header>

			<a href="/create-with-me/" class="work-request-banner" aria-label="お仕事の依頼はこちらから">
				<div class="work-request-copy">
					<span class="work-request-eyebrow">For Work</span>
					<span class="work-request-title">お仕事の依頼はこちらから</span>
				</div>
				<span class="work-request-arrow">
					<Icon icon="arrow-right" size="1.6rem" />
				</span>
			</a>

			<div class="gallery">
				<a href="/hami-preview/" class="hami-special-card">
					<div class="hami-card-bg" aria-hidden="true">
						<HamiImage src="/images/hami/food-pile.avif" alt="" class="hami-food-bg" />
						<HamiImage src="/images/hami/hami-dynamic.avif" alt="" class="hami-card-hami" />
						<HamiImage src="/images/hami/miru-dynamic.avif" alt="" class="hami-card-miru" />
					</div>
					<div class="hami-card-content">
						<span class="hami-eyebrow">SPECIAL SITE</span>
						<HamiImage src="/images/hami/logo.avif" alt="ハミちゃんの日常飯" class="hami-card-logo" />
						<p class="hami-subtitle">今日のご飯は一味違う？</p>
						<p class="hami-tagline">
							食べることが大好きなハミちゃんの、おいしい、うれしい、ちょっとおかしい日常飯アニメ。
						</p>
						<div class="hami-badge">
							<Icon icon="rocket-launch" size="1.5rem" />
							<span>OPEN SPECIAL</span>
						</div>
					</div>
				</a>

				<a href="/ghosts/" class="ghosts-special-card">
					<div class="ghosts-card-bg">
						<img
							src="/images/GHOSTS/logo.webp"
							alt="GHOSTSプロジェクトのロゴ。ノイズと静寂をテーマにした、サイバーパンク調の鋭利なデザイン"
							class="ghosts-logo"
						/>
					</div>
					<div class="ghosts-card-content">
						<h3 class="ghosts-title">GHOSTS</h3>
						<p class="ghosts-subtitle">プロジェクト始動！</p>
						<p class="ghosts-tagline">
							AI統治下の2163年、音楽が消された世界で立ち上がる4人の物語
						</p>
						<div class="ghosts-badge">
							<Icon icon="rocket-launch" size="1.5rem" />
							<span>NEW PROJECT</span>
						</div>
					</div>
				</a>

				<a href="/100days/" class="challenge-special-card">
					<div class="challenge-card-bg">
						<div class="challenge-icon-wrapper">
							<Icon icon="rocket-launch" size="4rem" />
						</div>
					</div>
					<div class="challenge-card-content">
						<h3 class="challenge-title">#AI創作100日チャレンジ</h3>
						<p class="challenge-subtitle">
							2025/8/9～ 毎日AI創作を続けた記録
						</p>
						<p class="challenge-tagline">
							生成AIで音楽・アニメ・ツールなど多彩な創作に挑戦した100日間の軌跡
						</p>
						<div class="challenge-badge">
							<Icon icon="strategy" size="1.5rem" />
							<span>100 DAYS COMPLETED</span>
						</div>
					</div>
				</a>
			</div>

			<div class="cta">
				<CallToAction href="/work/">
					<span>すべての作品を見る</span>
					<Icon icon="arrow-right" size="1.2em" />
				</CallToAction>
			</div>
		</section>

		<section class="section with-background bg-variant">
			<header class="section-header stack gap-2 lg:gap-4">
				<h3 data-i18n="links_title">Links</h3>
				<p data-i18n="links_desc">各種プラットフォームで活動中</p>
			</header>

			<div class="gallery">
				<Grid variant="small">
					<li class="link-card">
						<a
							href="https://x.com/M1RA_A_Project"
							target="_blank"
							rel="noopener noreferrer"
						>
							<Icon icon="x-logo" size="2em" />
							<p>X (Twitter)</p>
						</a>
					</li>
					<li class="link-card">
						<a
							href="https://www.pixiv.net/users/115350461"
							target="_blank"
							rel="noopener noreferrer"
						>
							<Icon icon="pixiv-logo" size="2em" />
							<p>Pixiv</p>
						</a>
					</li>
					<li class="link-card">
						<a
							href="http://www.youtube.com/@M1RA_Archive_Project"
							target="_blank"
							rel="noopener noreferrer"
						>
							<Icon icon="youtube-logo" size="2em" />
							<p>YouTube</p>
						</a>
					</li>
					<li class="link-card">
						<a
							href="https://note.com/m1ra_project"
							target="_blank"
							rel="noopener noreferrer"
						>
							<Icon icon="pencil-line" size="2em" />
							<p>Note</p>
						</a>
					</li>
				</Grid>
			</div>
		</section>
	</main>
</BaseLayout>

<ContactCTA />

<style>
	.hami-image {
		height: auto;
	}

	.site-title {
		position: fixed;
		top: 1rem;
		left: 1.5rem;
		z-index: 100;
		animation: siteTitleFadeIn 1.5s ease-out 0.5s forwards;
		opacity: 0;
	}

	.title-main {
		font-family:
			"Impact", "Arial Narrow", "Helvetica Condensed", sans-serif;
		font-size: clamp(1.2rem, 2.5vw, 1.8rem);
		font-weight: 900;
		color: #ffffff;
		margin: 0;
		text-shadow:
			0 0 4px rgba(255, 255, 255, 0.3),
			2px 2px 4px rgba(0, 0, 0, 0.9);
		letter-spacing: -0.5px;
		text-transform: uppercase;
		font-stretch: condensed;
	}

	.title-sub {
		font-family: "Arial Narrow", "Helvetica Condensed", sans-serif;
		font-size: clamp(0.85rem, 1.5vw, 1.1rem);
		color: #ffffff;
		margin: 0.25rem 0 0 0;
		text-shadow:
			0 0 3px rgba(255, 255, 255, 0.2),
			2px 2px 4px rgba(0, 0, 0, 0.9);
		letter-spacing: 0px;
		font-weight: 600;
	}

	@keyframes siteTitleFadeIn {
		0% {
			opacity: 0;
			transform: translateY(-10px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 768px) {
		.site-title {
			top: 0.75rem;
			left: 1rem;
		}

		.title-main {
			font-size: 1rem;
		}

		.title-sub {
			font-size: 0.75rem;
		}
	}

	.hero {
		width: 118%;
		margin-left: auto;
		margin-right: auto;
		margin-top: 5rem;
	}

	.hero-image-container {
		position: relative;
		width: 100%;
		height: auto;
		overflow: hidden;
	}

	.hero-image-container::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: repeating-linear-gradient(
			90deg,
			transparent,
			transparent 2px,
			rgba(255, 0, 0, 0.1) 2px,
			rgba(255, 0, 0, 0.1) 3px,
			transparent 3px,
			transparent 5px,
			rgba(0, 255, 0, 0.1) 5px,
			rgba(0, 255, 0, 0.1) 6px,
			transparent 6px,
			transparent 8px,
			rgba(0, 0, 255, 0.1) 8px,
			rgba(0, 0, 255, 0.1) 9px,
			transparent 9px,
			transparent 100px
		);
		pointer-events: none;
		z-index: 3;
		opacity: 0;
		animation: digitalGlitch 4s infinite;
	}

	.hero-image {
		width: 100%;
		height: auto;
		display: block;
		object-fit: contain;
		filter: contrast(1.1) brightness(1.05);
		animation:
			imageShift 4s infinite,
			heroFadeIn 2.5s ease-out 3s;
		opacity: 0;
		animation-fill-mode: forwards;
	}

	@keyframes heroFadeIn {
		0% {
			opacity: 0;
		}
		100% {
			opacity: 1;
		}
	}

	@keyframes digitalGlitch {
		0%,
		94%,
		100% {
			opacity: 0;
		}
		94.5% {
			opacity: 0.8;
			transform: translateX(2px);
		}
		95% {
			opacity: 0;
		}
		95.5% {
			opacity: 0.6;
			transform: translateX(-3px);
		}
		96% {
			opacity: 0;
		}
		96.2% {
			opacity: 0.7;
			transform: translateX(1px);
		}
		96.5% {
			opacity: 0;
		}
	}

	@keyframes imageShift {
		0%,
		94%,
		100% {
			transform: translate(0, 0);
		}
		94.5% {
			transform: translate(1px, -1px);
		}
		95.5% {
			transform: translate(-2px, 1px);
		}
		96.2% {
			transform: translate(1px, 0);
		}
	}

	.hero-text-overlay {
		position: absolute;
		bottom: 5%;
		left: 5%;
		max-width: 90%;
	}

	.hero-title {
		font-size: clamp(1rem, 2.5vw, 2rem);
		font-weight: 900;
		color: #ffffff;
		margin: 0 0 0.5rem 0;
		font-family:
			"Inter",
			"Helvetica Neue",
			-apple-system,
			BlinkMacSystemFont,
			sans-serif;
		text-shadow:
			0 2px 8px rgba(0, 0, 0, 0.8),
			0 4px 16px rgba(0, 0, 0, 0.6);
		letter-spacing: -0.02em;
	}

	.hero-tagline {
		font-size: clamp(0.5rem, 1.25vw, 0.75rem);
		color: #ffffff;
		margin: 0 0 1rem 0;
		font-weight: 500;
		text-shadow:
			0 2px 8px rgba(0, 0, 0, 0.8),
			0 4px 12px rgba(0, 0, 0, 0.6);
		font-family:
			"Inter",
			"Helvetica Neue",
			-apple-system,
			BlinkMacSystemFont,
			sans-serif;
	}

	.roles {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.roles :global(.pill) {
		font-size: clamp(0.5rem, 1.25vw, 0.75rem);
		padding: 0.25rem 0.5rem;
	}

	.roles :global(.pill svg) {
		width: 0.8em;
		height: 0.8em;
	}

	.intro-section {
		margin-top: 2rem;
		padding: 3rem;
		background: rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(10px);
		border-radius: 0.5rem;
		border: 12px solid;
		border-image: linear-gradient(
				135deg,
				rgba(139, 115, 85, 0.6),
				rgba(205, 183, 158, 0.8),
				rgba(139, 115, 85, 0.6)
			)
			1;
		box-shadow:
			inset 0 0 20px rgba(255, 255, 255, 0.1),
			0 4px 20px rgba(0, 0, 0, 0.5);
		position: relative;
	}

	.intro-section::before {
		content: "";
		position: absolute;
		top: 8px;
		left: 8px;
		right: 8px;
		bottom: 8px;
		border: 1px solid rgba(139, 115, 85, 0.3);
		pointer-events: none;
		border-radius: 0.25rem;
	}

	.intro-layout {
		display: flex;
		align-items: center;
		gap: 3rem;
		margin-bottom: 3rem;
	}

	.intro-videos {
		margin-top: 2rem;
		border-top: 2px solid rgba(255, 255, 255, 0.1);
		padding-top: 2rem;
	}

	.intro-content {
		flex: 1;
		min-width: 0;
	}

	.intro-content h2 {
		font-size: var(--text-xl);
		color: #ffffff;
		margin-bottom: 1rem;
		font-family:
			"HG丸ｺﾞｼｯｸM-PRO", "Hiragino Maru Gothic ProN", "メイリオ", "Meiryo",
			"ＭＳ Ｐゴシック", sans-serif;
		font-weight: 700;
		letter-spacing: 0.5px;
		text-shadow:
			0 0 10px rgba(0, 0, 0, 0.9),
			2px 2px 4px rgba(0, 0, 0, 0.8),
			0 0 20px rgba(0, 255, 136, 0.3);
		background: rgba(0, 0, 0, 0.5);
