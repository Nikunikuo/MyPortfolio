			gap: 2rem;
		}

		.card-hand {
			height: 220px;
			min-width: 100%;
		}

		.card {
			width: 140px;
			height: 200px;
		}

		.card-1 {
			transform: rotate(-12deg) translateX(-50px);
		}

		.card-3 {
			transform: rotate(12deg) translateX(50px);
		}
