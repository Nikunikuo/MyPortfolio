		line-height: 1.8;
		color: #ffffff;
		font-family:
			"HG丸ｺﾞｼｯｸM-PRO", "Hiragino Maru Gothic ProN", "ヒラギノ丸ゴ ProN",
			"メイリオ", "Meiryo", sans-serif;
		font-weight: 500;
		text-shadow:
			0 0 8px rgba(0, 0, 0, 0.9),
