---
import BaseLayout from '../layouts/BaseLayout.astro';
import CreatorNav from '../components/CreatorNav.astro';
import CreatorFooter from '../components/CreatorFooter.astro';
import '../styles/studio-overprint.css';
import '../styles/home-overprint.css';

const homeStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	'@id': 'https://niku.studio/#independent-ip',
	name: '大鹿ニクの独自IP作品',
	description: '大鹿ニクが制作する独自IP作品と、そのほかの映像・音楽・アニメーション。',
	url: 'https://niku.studio/',
	mainEntity: {
		'@type': 'ItemList',
		name: '独自IP作品',
		numberOfItems: 2,
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				url: 'https://niku.studio/hami-preview/',
				name: 'ハミちゃんの日常飯',
			},
			{
				'@type': 'ListItem',
				position: 2,
				url: 'https://niku.studio/ghosts/',
				name: 'GHOSTS',
			},
		],
	},
};
---

<BaseLayout
	title="NIKU STUDIO — 大鹿ニクの秘密基地"
	description="生成AIを制作手段のひとつとして、映像、音楽、アニメーション、Webを制作する大鹿ニクのポートフォリオ。"
	showChrome={false}
	htmlTheme="overprint"
	headVariant="creator"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(homeStructuredData)} />
	</Fragment>

	<main class="portfolio">
		<CreatorNav home />

		<section class="hero hero-poster" aria-labelledby="hero-title">
			<div class="poster-top"><p>映像・音楽・アニメーション</p><span>大鹿ニクの秘密基地</span></div>
			<div class="poster-composition">
				<div class="poster-wordmark" aria-hidden="true"><span>NIKU</span><span>STUDIO</span></div>
				<figure class="hero-art">
					<img src="/images/top.png" alt="大鹿ニクのキービジュアル" width="1344" height="768" fetchpriority="high" decoding="async" />
					<figcaption>大鹿ニク / NIKU STUDIO</figcaption>
				</figure>
				<span class="poster-index" aria-hidden="true">N / S</span>
				<h1 id="hero-title">
					<span>創ることが、</span>
					<span>やめられねぇんだ！</span>
				</h1>
			</div>
			<div class="poster-foot">
				<p class="hero-intro">生成AIを制作手段のひとつとして、<br />映像、音楽、アニメーション、Webをつくっています。</p>
				<a class="hero-link" href="#series">作品を見る <span aria-hidden="true">↘</span></a>
			</div>
		</section>

		<section class="series" id="series" aria-labelledby="series-title">
			<header class="section-heading">
				<p>01 / ORIGINALS</p>
				<h2 id="series-title">独自IP作品</h2>
			</header>

			<div class="series-links">
				<a class="series-link hami" href="/hami-preview/">
					<div class="series-media">
						<img
							src="/images/hami/food-pile.avif"
							alt=""
							width="1800"
							height="1100"
							loading="lazy"
							decoding="async"
						/>
						<img
							class="hami-logo"
							src="/images/hami/logo.avif"
							alt="ハミちゃんの日常飯"
							width="1376"
							height="768"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<div class="series-copy">
						<p>短編アニメ / 公開中</p>
						<h3>ハミちゃんの日常飯</h3>
						<span>食べることから始まる日常アニメ。14話を公開中。</span>
					</div>
					<b aria-hidden="true">↗</b>
				</a>

				<a class="series-link ghosts" href="/ghosts/">
					<div class="series-media" aria-hidden="true">
						<img
							src="/images/GHOSTS/poster1.webp"
							alt=""
							width="3584"
							height="4608"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<div class="series-copy">
						<p>物語・音楽 / 連載中</p>
						<h3>GHOSTS</h3>
						<span>2163年、音楽が消された世界の物語。</span>
					</div>
					<b aria-hidden="true">↗</b>
				</a>
			</div>
		</section>

		<section class="works" id="works" aria-labelledby="works-title">
			<header class="section-heading">
				<p>02 / ARCHIVE</p>
				<h2 id="works-title">その他制作物の倉庫</h2>
			</header>

			<ol class="works-list">
				<li>
					<a href="/work/music-videos/">
						<span class="work-mark">MV</span>
						<strong>Music Videos</strong>
						<small>音楽と映像</small>
						<i aria-hidden="true">↗</i>
					</a>
				</li>
				<li>
					<a href="/video-archive/">
						<span class="work-mark">映</span>
						<strong>映像作品アーカイブ</strong>
						<small>短編・アニメーション</small>
						<i aria-hidden="true">↗</i>
					</a>
				</li>
				<li>
					<a href="/100days/">
						<span class="work-mark">百</span>
						<strong>#AI創作100日</strong>
						<small>制作記録</small>
						<i aria-hidden="true">↗</i>
					</a>
				</li>
			</ol>
			<a class="all-works creator-text-link" href="/work/">倉庫を開く <span aria-hidden="true">↗</span></a>
		</section>

		<section class="contact" aria-labelledby="contact-title">
			<div>
				<p>仕事の相談</p>
				<h2 id="contact-title">一緒につくる。</h2>
				<span>まずは、話を聞かせてください。</span>
			</div>
			<a href="/create-with-me/">連絡する <span aria-hidden="true">↗</span></a>
		</section>

		<CreatorFooter />
	</main>
</BaseLayout>
