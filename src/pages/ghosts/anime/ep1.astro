---
import Icon from "../../../components/Icon.astro";

const pageTitle = "GHOSTS - Noise in the Silence EP1";
const pageDescription = "GHOSTS長編アニメ エピソード１「Noise in the Silence」";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=5.0"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="GHOSTS, アニメ, サイバーパンク, Noise in the Silence"
    />
    <meta name="author" content="大鹿ニク / M1RA" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0F0F1E" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="video.other" />
    <meta property="og:site_name" content="GHOSTS - niku.studio" />
    <meta
      property="og:image"
      content={new URL("/images/GHOSTS/logo.webp", Astro.site)}
    />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta
      name="twitter:image"
      content={new URL("/images/GHOSTS/logo.webp", Astro.site)}
    />
    <meta name="twitter:site" content="@M1RA_A_Project" />
  </head>
  <body class="ghosts-body">
    <!-- Floating Logo -->
    <a href="/ghosts/" class="floating-logo">
      <img
        src="/images/GHOSTS/logo.webp"
        alt="GHOSTSプロジェクトのロゴ"
      />
    </a>

    <main>
      <div class="novel-container">
        <!-- Header -->
        <section class="novel-header">
          <h1 class="page-title">Noise in the Silence <br/>- EPISODE 1</h1>
          <p class="page-description">
            GHOSTS 長編アニメーション
          </p>
        </section>

        <!-- Video Embed -->
        <section class="video-section">
          <div class="video-container">
            <iframe
              src="https://www.youtube.com/embed/6WqO4LywQ2U"
              title="YouTube video player"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              class="youtube-embed"
            ></iframe>
          </div>
          
          <div class="external-links">
            <a href="https://anipops.com/video/69d8f42c996ed93fc47ff5dc" target="_blank" rel="noopener noreferrer" class="anipops-link">
              <span class="link-text">Anipopsで視聴する</span>
              <span class="link-arrow">→</span>
            </a>
          </div>
        </section>

        <!-- Back Link -->
        <div class="back-section">
          <a href="/ghosts/anime/" class="back-link">← アニメ一覧に戻る</a>
        </div>
      </div>
    </main>
  </body>
</html>

<style is:global>
  /* Base styles */
  * { box-sizing: border-box; margin: 0; padding: 0; }
  .ghosts-body {
    background: #0f0f1e; color: #e0e0e0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    line-height: 1.6; overflow-x: hidden;
  }
  .floating-logo { position: fixed; top: 2rem; left: 2rem; z-index: 100; transition: all 0.3s ease; }
  .floating-logo img { height: 60px; width: auto; filter: drop-shadow(0 0 10px rgba(255, 8, 68, 0.5)); transition: all 0.3s ease; }
  .floating-logo:hover img { filter: drop-shadow(0 0 15px rgba(39, 225, 255, 0.8)); transform: scale(1.05); }
  @media (max-width: 768px) {
    .floating-logo { top: 1rem; left: 1rem; }
    .floating-logo img { height: 44px; }
  }
  main { padding-top: 100px; }
</style>

<style>
  .novel-container { max-width: 900px; margin: 0 auto; padding: 2rem; }
  .novel-header { text-align: center; margin-bottom: 2rem; padding: 2rem 0; }
  .page-title {
    font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 900; color: #ff0844;
    margin-bottom: 1rem; letter-spacing: 0.1rem; line-height: 1.2;
    text-shadow: 0 0 20px rgba(255, 8, 68, 0.8);
  }
  .page-description { font-size: clamp(1rem, 2vw, 1.25rem); color: #b0b0b0; }

  /* Video Layout */
  .video-section {
    margin-bottom: 4rem;
  }
  .video-container {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 0 30px rgba(255, 8, 68, 0.2);
    border: 1px solid rgba(255, 8, 68, 0.3);
  }
  .youtube-embed {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .external-links {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
  }
  .anipops-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2.5rem;
    background: linear-gradient(135deg, #7b2cbf, #9d4edd);
    border-radius: 50px;
    color: white;
    text-decoration: none;
    font-weight: bold;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    box-shadow: 0 4px 15px rgba(157, 78, 221, 0.4);
    transition: all 0.3s ease;
  }
  .anipops-link:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(157, 78, 221, 0.6);
  }

  .back-section { text-align: center; margin-top: 4rem; }
  .back-link {
    display: inline-block; padding: 1rem 2rem;
    background: rgba(39, 225, 255, 0.1); border: 2px solid rgba(39, 225, 255, 0.3);
    border-radius: 0.5rem; color: #27e1ff; text-decoration: none;
    font-weight: 600; transition: all 0.3s ease;
  }
  .back-link:hover {
    background: rgba(39, 225, 255, 0.2); border-color: #27e1ff;
    box-shadow: 0 0 20px rgba(39, 225, 255, 0.3); transform: translateX(-5px);
  }
  @media (max-width: 768px) {
    .novel-container { padding: 1rem; }
  }
</style>
