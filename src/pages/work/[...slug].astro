---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import CreatorContactStrip from '../../components/CreatorContactStrip.astro';
import CreatorLayout from '../../layouts/CreatorLayout.astro';

interface Props {
	entry: CollectionEntry<'work'>;
}

export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const videoId = entry.data.youtubeUrl?.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([^&?\/]+)/)?.[1];
const dateLabel = entry.data.publishDate.toLocaleDateString('ja-JP', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
});
const pageUrl = `https://niku.studio/work/${entry.id}/`;

const structuredData: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': videoId ? 'VideoObject' : 'CreativeWork',
	name: entry.data.title,
	description: entry.data.description,
	datePublished: entry.data.publishDate.toISOString(),
	url: pageUrl,
	creator: { '@id': 'https://niku.studio/#person' },
};

if (videoId) {
	structuredData.embedUrl = `https://www.youtube.com/embed/${videoId}`;
	structuredData.contentUrl = `https://www.youtube.com/watch?v=${videoId}`;
	structuredData.thumbnailUrl = `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
}
---

<CreatorLayout
	title={`${entry.data.title} | 大鹿ニク`}
	description={entry.data.description}
	eyebrow={`WORK / ${dateLabel}`}
	heading={entry.data.title}
	intro={entry.data.description}
	number="映"
	backHref="/video-archive/"
	backLabel="映像作品アーカイブ"
	compact
	structuredData={structuredData}
>
	<article class="work-detail">
		<ul class="creator-tags" aria-label="作品タグ">
			{entry.data.tags.map((tag) => <li>{tag}</li>)}
		</ul>

		{
			videoId ? (
				<div class="creator-video">
					<iframe
						src={`https://www.youtube.com/embed/${videoId}`}
						title={entry.data.title}
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					/>
				</div>
			) : (
				<figure class="creator-media-frame">
					<img src={entry.data.img} alt={entry.data.img_alt || '作品のサムネイル画像'} />
				</figure>
			)
		}

		<div class="creator-prose work-prose">
			<Content />
		</div>
	</article>

	<CreatorContactStrip />
</CreatorLayout>

<style>
	.work-detail {
		display: grid;
		gap: clamp(44px, 7vw, 92px);
		max-width: 1180px;
		margin-inline: auto;
		padding-bottom: clamp(90px, 13vw, 170px);
	}

	.work-prose {
		width: min(100%, 72ch);
		margin-inline: auto;
	}

	.work-prose :global(ul),
	.work-prose :global(ol) {
		padding-left: 1.4em;
	}

	.work-prose :global(li + li) {
		margin-top: 0.6em;
	}
</style>
