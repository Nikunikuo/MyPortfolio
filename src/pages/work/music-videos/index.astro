---
import CreatorContactStrip from '../../../components/CreatorContactStrip.astro';
import CreatorLayout from '../../../layouts/CreatorLayout.astro';
import { musicVideos } from '../../../data/musicVideos';

const title = 'ミュージックビデオ | 大鹿ニク';
const description = `大鹿ニクが制作したミュージックビデオ全${musicVideos.length}作品。音楽と映像を一本ずつまとめたアーカイブ。`;

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://niku.studio/' },
			{ '@type': 'ListItem', position: 2, name: '制作物', item: 'https://niku.studio/work/' },
			{ '@type': 'ListItem', position: 3, name: 'ミュージックビデオ', item: 'https://niku.studio/work/music-videos/' },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		name: 'ミュージックビデオ',
		description,
		url: 'https://niku.studio/work/music-videos/',
		mainEntity: {
			'@type': 'ItemList',
			numberOfItems: musicVideos.length,
			itemListElement: musicVideos.map((mv, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				item: {
					'@type': 'VideoObject',
					name: mv.title,
					description: mv.intro,
					embedUrl: `https://www.youtube.com/embed/${mv.youtubeId}`,
					thumbnailUrl: `https://i.ytimg.com/vi/${mv.youtubeId}/maxresdefault.jpg`,
					url: `https://niku.studio/work/music-videos/${mv.slug}/`,
					creator: { '@id': 'https://niku.studio/#person' },
				},
			})),
		},
	},
];
---

<CreatorLayout
	title={title}
	description={description}
	eyebrow="MUSIC / VIDEO"
	heading="Music Videos"
	intro={`音をつくり、画をつくり、編集して一本にする。公開中の${musicVideos.length}本を新しい順に並べています。`}
	number="MV"
	backHref="/work/"
	backLabel="その他制作物の倉庫"
	structuredData={structuredData}
>
	<section class="mv-grid" aria-label="ミュージックビデオ一覧">
		{
			musicVideos.map((mv, index) => (
				<a class="mv-entry" href={`/work/music-videos/${mv.slug}/`}>
					<figure class="mv-thumb">
						<img
							src={`https://i.ytimg.com/vi/${mv.youtubeId}/hqdefault.jpg`}
							alt={`${mv.title} の動画サムネイル`}
							width="480"
							height="360"
							loading={index < 2 ? 'eager' : 'lazy'}
							decoding="async"
						/>
						{mv.isNew && <span class="mv-new">NEW</span>}
					</figure>
					<div class="mv-copy">
						<span class="mv-index">{String(index + 1).padStart(2, '0')}</span>
						<h2>{mv.title}</h2>
						<p>{mv.intro}</p>
						<i aria-hidden="true">↗</i>
					</div>
				</a>
			))
		}
	</section>

	<CreatorContactStrip />
</CreatorLayout>

<style>
	.mv-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(46px, 7vw, 110px) clamp(18px, 4vw, 64px);
		padding-bottom: clamp(90px, 13vw, 180px);
	}

	.mv-entry {
		display: block;
		min-width: 0;
		color: inherit;
		text-decoration: none;
	}

	.mv-entry:nth-child(even) {
		margin-top: clamp(70px, 10vw, 150px);
	}

	.mv-thumb {
		position: relative;
		overflow: hidden;
		margin: 0;
		aspect-ratio: 16 / 10;
		border: 2px solid var(--studio-ink);
		background: var(--studio-paper);
		box-shadow: 8px 8px 0 var(--studio-ink);
	}

	.mv-thumb::after {
		position: absolute;
		inset: 0;
		background: none;
		content: "";
		pointer-events: none;
	}

	.mv-thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: none;
		transition: filter 200ms ease, transform 280ms ease;
	}

	.mv-entry:hover .mv-thumb img,
	.mv-entry:focus-visible .mv-thumb img {
		filter: saturate(1) contrast(1.04);
		transform: scale(1.025);
	}

	.mv-entry:focus-visible {
		outline: 3px solid var(--studio-accent);
		outline-offset: 6px;
	}

	.mv-new {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 2;
		padding: 10px 14px;
		background: var(--studio-accent);
		color: var(--studio-ink);
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.82rem;
		font-weight: 600;
	}

	.mv-copy {
		position: relative;
		min-height: 200px;
		padding: 22px 42px 22px 0;
		border-bottom: 1px solid var(--studio-line);
	}

	.mv-index {
		color: var(--studio-ink);
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.82rem;
		font-weight: 600;
	}

	.mv-copy h2 {
		margin: 30px 0 16px;
		color: var(--studio-ink);
		font-family: var(--font-brand);
		font-size: clamp(1.8rem, 3.5vw, 3.7rem);
		font-weight: 900;
		letter-spacing: -0.06em;
		line-height: 1.2;
	}

	.mv-copy p {
		max-width: 48ch;
		color: var(--studio-muted);
		line-height: 1.75;
	}

	.mv-copy i {
		position: absolute;
		right: 0;
		bottom: 22px;
		font-family: "IBM Plex Mono", monospace;
		font-size: 1.5rem;
		font-style: normal;
	}

	@media (max-width: 760px) {
		.mv-grid {
			grid-template-columns: 1fr;
		}

		.mv-entry:nth-child(even) {
			margin-top: 0;
		}

		.mv-copy {
			min-height: 170px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mv-thumb img {
			transition: none;
		}
	}
</style>
