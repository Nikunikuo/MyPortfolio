---
import CreatorContactStrip from '../../../components/CreatorContactStrip.astro';
import CreatorLayout from '../../../layouts/CreatorLayout.astro';
import { musicVideos, type MusicVideo } from '../../../data/musicVideos';

export function getStaticPaths() {
	return musicVideos.map((mv) => ({
		params: { slug: mv.slug },
		props: { mv },
	}));
}

interface Props {
	mv: MusicVideo;
}

const { mv } = Astro.props;
const currentIndex = musicVideos.findIndex((item) => item.slug === mv.slug);
const previous = currentIndex > 0 ? musicVideos[currentIndex - 1] : undefined;
const next = currentIndex < musicVideos.length - 1 ? musicVideos[currentIndex + 1] : undefined;
const title = `${mv.title} | ミュージックビデオ | 大鹿ニク`;
const description = `${mv.intro} 大鹿ニクが制作したミュージックビデオ。`;

const videoStructuredData: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'VideoObject',
	name: mv.title,
	description: mv.intro,
	thumbnailUrl: [
		`https://i.ytimg.com/vi/${mv.youtubeId}/maxresdefault.jpg`,
		`https://i.ytimg.com/vi/${mv.youtubeId}/sddefault.jpg`,
	],
	embedUrl: `https://www.youtube.com/embed/${mv.youtubeId}`,
	contentUrl: `https://www.youtube.com/watch?v=${mv.youtubeId}`,
	url: `https://niku.studio/work/music-videos/${mv.slug}/`,
	inLanguage: 'ja',
	creator: { '@id': 'https://niku.studio/#person' },
	isPartOf: {
		'@type': 'CollectionPage',
		name: 'ミュージックビデオ',
		url: 'https://niku.studio/work/music-videos/',
	},
};

if (mv.releaseDate) videoStructuredData.uploadDate = mv.releaseDate;
---

<CreatorLayout
	title={title}
	description={description}
	eyebrow="MUSIC VIDEO"
	heading={mv.title}
	intro={mv.intro}
	number={mv.slug}
	backHref="/work/music-videos/"
	backLabel="ミュージックビデオ一覧"
	compact
	structuredData={videoStructuredData}
>
	<article class="mv-detail">
		<div class="creator-video">
			<iframe
				src={`https://www.youtube.com/embed/${mv.youtubeId}`}
				title={mv.title}
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
				allowfullscreen
			/>
		</div>

		<section class="mv-note" aria-labelledby="about-work-title">
			<p class="creator-section-kicker">ABOUT THIS WORK</p>
			<h2 id="about-work-title">作品について</h2>
			<p>{mv.intro}</p>
			<a
				class="creator-text-link"
				href={`https://www.youtube.com/watch?v=${mv.youtubeId}`}
				target="_blank"
				rel="noopener noreferrer"
			>
				YouTubeで再生する <span aria-hidden="true">↗</span>
			</a>
		</section>

		<nav class="mv-pager" aria-label="別のミュージックビデオ">
			{
				previous ? (
					<a href={`/work/music-videos/${previous.slug}/`}>
						<span>← PREV</span>
						<strong>{previous.title}</strong>
					</a>
				) : <span aria-hidden="true"></span>
			}
			{
				next && (
					<a href={`/work/music-videos/${next.slug}/`} class="next">
						<span>NEXT →</span>
						<strong>{next.title}</strong>
					</a>
				)
			}
		</nav>
	</article>

	<CreatorContactStrip />
</CreatorLayout>

<style>
	.mv-detail {
		display: grid;
		grid-template-columns: minmax(0, 1.28fr) minmax(260px, 0.72fr);
		gap: clamp(36px, 6vw, 92px);
		align-items: start;
		padding-bottom: clamp(90px, 13vw, 170px);
	}

	.mv-note {
		padding-top: 16px;
		border-top: 2px solid var(--studio-ink);
	}

	.mv-note h2 {
		margin: clamp(42px, 7vw, 86px) 0 24px;
		color: var(--studio-ink);
		font-family: var(--font-brand);
		font-size: clamp(2.2rem, 4.5vw, 4.8rem);
		font-weight: var(--font-brand-weight);
		letter-spacing: var(--tracking-heading);
		line-height: 1.3;
		overflow-wrap: anywhere;
	}

	.mv-note > p:not(.creator-section-kicker) {
		color: var(--studio-muted);
		font-size: 1.05rem;
		line-height: 1.9;
	}

	.mv-note .creator-text-link {
		margin-top: 34px;
	}

	.mv-pager {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-top: clamp(50px, 8vw, 110px);
		border-top: 2px solid var(--studio-ink);
		border-left: 1px solid var(--studio-line);
	}

	.mv-pager a,
	.mv-pager > span {
		min-height: 150px;
		padding: 24px;
		border-right: 1px solid var(--studio-line);
		border-bottom: 1px solid var(--studio-line);
		color: inherit;
		text-decoration: none;
	}

	.mv-pager a {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		transition: background-color 180ms ease, color 180ms ease;
	}

	.mv-pager a:hover,
	.mv-pager a:focus-visible {
		background: var(--studio-accent);
		color: var(--studio-ink);
		outline: none;
	}

	.mv-pager .next {
		text-align: right;
	}

	.mv-pager span {
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.75rem;
		font-weight: 600;
	}

	.mv-pager strong {
		font-family: var(--font-body);
		font-size: clamp(1.25rem, 2.5vw, 2.35rem);
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1.35;
		overflow-wrap: anywhere;
	}

	@media (max-width: 820px) {
		.mv-detail {
			grid-template-columns: 1fr;
		}

		.mv-pager {
			grid-template-columns: 1fr;
		}

		.mv-pager > span:empty {
			display: none;
		}
	}
</style>
