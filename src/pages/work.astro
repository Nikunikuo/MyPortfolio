---
import CreatorContactStrip from '../components/CreatorContactStrip.astro';
import CreatorLayout from '../layouts/CreatorLayout.astro';
import { musicVideos } from '../data/musicVideos';

const title = 'その他制作物の倉庫 | 大鹿ニク';
const description = '大鹿ニクが制作したミュージックビデオ、短編映像、AI創作100日チャレンジ、音楽・Web制作物のアーカイブ。';

const archives = [
	{
		mark: 'MV',
		title: 'Music Videos',
		meta: `${musicVideos.length}本 / 音楽と映像`,
		href: '/work/music-videos/',
	},
	{
		mark: '映',
		title: '映像作品アーカイブ',
		meta: '短編・アニメーション',
		href: '/video-archive/',
	},
	{
		mark: '百',
		title: '#AI創作100日',
		meta: '100日分の制作記録',
		href: '/100days/',
	},
];

const outsideLinks = [
	{ label: 'Suno', href: 'https://suno.com/@yajusika' },
	{ label: 'Spotify', href: 'https://open.spotify.com/intl-ja/artist/4MjpBNzO8tRzviKOgXeHoY' },
	{ label: 'Apple Music', href: 'https://music.apple.com/jp/artist/%E5%A4%A7%E9%B9%BF%E3%83%8B%E3%82%AF/1831287955' },
	{ label: '大鹿堂 / BOOTH', href: 'https://nikuoosika.booth.pm/' },
	{ label: 'GitHub', href: 'https://github.com/Nikunikuo' },
];

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'その他制作物の倉庫',
	description,
	url: 'https://niku.studio/work/',
	inLanguage: 'ja-JP',
	mainEntity: {
		'@type': 'ItemList',
		numberOfItems: archives.length,
		itemListElement: archives.map((archive, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: archive.title,
			url: new URL(archive.href, 'https://niku.studio').href,
		})),
	},
};
---

<CreatorLayout
	title={title}
	description={description}
	eyebrow="WORKS / ARCHIVE"
	heading="その他制作物の倉庫"
	intro="完成したもの、試したもの、積み上げたもの。いま見せられる制作物だけを、種類ごとに置いています。"
	number="02"
	structuredData={structuredData}
>
	<section class="creator-section" aria-labelledby="archive-title">
		<header class="creator-section-heading">
			<p class="creator-section-kicker">OPEN THE DOOR</p>
			<h2 id="archive-title">見られるもの</h2>
		</header>
		<div class="creator-section-content">
			<ol class="creator-rows archive-rows">
				{
					archives.map((archive, index) => (
						<li class="creator-row">
							<a href={archive.href}>
								<span class="archive-mark">{archive.mark}</span>
								<strong class="creator-row-title">{archive.title}</strong>
								<span class="creator-row-meta">{archive.meta}</span>
								<i class="creator-row-arrow" aria-hidden="true">↗</i>
							</a>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="creator-section" aria-labelledby="outside-title">
		<header class="creator-section-heading">
			<p class="creator-section-kicker">ELSEWHERE</p>
			<h2 id="outside-title">外にあるもの</h2>
		</header>
		<div class="creator-section-content">
			<div class="creator-link-grid">
				{
					outsideLinks.map((link) => (
						<a href={link.href} target="_blank" rel="noopener noreferrer">
							<span>{link.label} ↗</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<CreatorContactStrip />
</CreatorLayout>

<style>
	.archive-rows {
		counter-reset: archive;
	}

	.archive-mark {
		display: grid;
		place-items: center;
		width: clamp(44px, 5.5vw, 72px);
		aspect-ratio: 1;
		border: 2px solid currentColor;
		font-family: var(--font-brand);
		font-size: clamp(1.4rem, 2.8vw, 2.6rem);
		font-weight: 700;
		line-height: 1.2;
	}

	@media (max-width: 720px) {
		.archive-mark {
			width: 40px;
			font-size: 1.3rem;
		}
	}
</style>
